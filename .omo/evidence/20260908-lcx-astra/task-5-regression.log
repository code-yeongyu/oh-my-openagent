if [ -f "$HOME/.omo/omo.jsonc" ]; then omo_after="$(shasum "$HOME/.omo/omo.jsonc" | awk '{print $1}')"; else omo_after=ABSENT; fi
printf 'REAL_OMO_CONFIG_AFTER=%s\n' "$omo_after"
[ "$omo_before" = "$omo_after" ]
