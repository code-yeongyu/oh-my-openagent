#!/usr/bin/env bash
set -euo pipefail
cd /Volumes/mengmotaStorage/local-workspaces/omo-wt/lcx-astra-default-models
export REPO_ROOT="$PWD"
. .agents/skills/codex-qa/scripts/lib/common.sh
cqa_guard_real_home
printf 'REAL_CODEX_BEFORE=%s\n' "$CQA_REAL_HOME_SUM"
real_home="$HOME"
if [ -f "$HOME/.omo/omo.jsonc" ]; then omo_before="$(shasum "$HOME/.omo/omo.jsonc" | awk '{print $1}')"; else omo_before=ABSENT; fi
printf 'REAL_OMO_CONFIG_BEFORE=%s\n' "$omo_before"
cqa_mk_isolated_home
export HOME="$CQA_HOME_ROOT/home"
mkdir -p "$HOME" "$CODEX_HOME/agents"
export XDG_CONFIG_HOME="$HOME/.config" XDG_CACHE_HOME="$HOME/.cache" XDG_DATA_HOME="$HOME/.local/share"
export OMO_SKIP_MATERIALIZE=1
export PATH="$real_home/.bun/bin:$real_home/.local/bin:$PATH"
printf 'ISOLATED_CODEX_HOME=%s\n' "$CODEX_HOME"
printf 'name = "momus"\nmodel = "gpt-5.5"\nmodel_reasoning_effort = "xhigh"\n' > "$CODEX_HOME/agents/momus.toml"
printf 'name = "explorer"\nmodel = "gpt-5.6-luna"\nmodel_reasoning_effort = "xhigh"\n' > "$CODEX_HOME/agents/explorer.toml"
printf 'name = "librarian"\nmodel = "gpt-5.6-luna-fast"\nmodel_reasoning_effort = "low"\n' > "$CODEX_HOME/agents/librarian.toml"
printf '[agents.momus]\nconfig_file = "./agents/momus.toml"\n[agents.explorer]\nconfig_file = "./agents/explorer.toml"\n[agents.librarian]\nconfig_file = "./agents/librarian.toml"\n' > "$CODEX_HOME/config.toml"
printf 'SEED=momus:gpt-5.5/xhigh explorer:gpt-5.6-luna/xhigh librarian:gpt-5.6-luna-fast/low\n'
printf '$ node packages/omo-codex/scripts/install-local.mjs install\n'
if cqa_install_local_omo; then code=0; else code=$?; fi
node -e 'process.stdout.write(require("node:fs").readFileSync(process.env.CQA_HOME_ROOT + "/install.log", "utf8"))'
printf 'INSTALL_EXIT=%s\n' "$code"
[ "$code" -eq 0 ]
node --input-type=module <<'JS'
import assert from 'node:assert/strict';
import { readFile, readdir } from 'node:fs/promises';
import { join } from 'node:path';
const home = process.env.CODEX_HOME;
const files = (await readdir(join(home, 'agents'))).filter(f => f.endsWith('.toml')).sort();
assert.equal(files.length, 12);
for (const file of files) {
  const text = await readFile(join(home, 'agents', file), 'utf8');
  const model = /^model\s*=\s*"([^"]+)"/m.exec(text)?.[1];
  const effort = /^model_reasoning_effort\s*=\s*"([^"]+)"/m.exec(text)?.[1];
  assert.equal(model, 'gpt-6-astra');
  if (file === 'momus.toml') assert.equal(effort, 'high');
  if (file === 'explorer.toml') assert.equal(effort, 'xhigh');
  if (file === 'librarian.toml') assert.equal(effort, 'low');
  console.log(`INSTALLED ${file} model=${model} effort=${effort}`);
}
const config = await readFile(join(home, 'config.toml'), 'utf8');
assert.equal([...config.matchAll(/^\[agents\.[^\]]+\]/gm)].length, 12);
console.log('PASS: 12 Astra agents registered; momus legacy effort upgraded; explorer customization preserved; librarian low retained');
JS
export HOME="$real_home"
