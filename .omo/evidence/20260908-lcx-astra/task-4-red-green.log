#!/usr/bin/env bash
set -euo pipefail
cd "$LCX_WORKTREE"
export REPO_ROOT="$LCX_WORKTREE"
source .agents/skills/codex-qa/scripts/lib/common.sh
cqa_guard_real_home
printf 'REAL_CONFIG_SHA1_BEFORE=%s\n' "$CQA_REAL_HOME_SUM"
for mode in managed user; do
  cqa_mk_isolated_home
  printf '\nCASE=%s ISOLATED_HOME=%s\n' "$mode" "$CODEX_HOME"
  "$(cqa_codex_bin)" --version
  export FIX4B_MODE="$mode"
  if [ "$mode" = managed ]; then
    printf '%s\n' 'model = "gpt-6-astra"' '[agents]' '  "max_threads"   = 1000 # managed' 'max_depth = 4' '[features.multi_agent_v2]' "  'max_concurrent_threads_per_session' = 16 # managed" > "$CODEX_HOME/config.toml"
  else
    printf '%s\n' 'model = "gpt-5.5"' '[agents]' "  'max_threads' = 16 # user" 'max_depth = 4' '[features.multi_agent_v2]' 'enabled = false' '  "max_concurrent_threads_per_session" = 8 # user' > "$CODEX_HOME/config.toml"
  fi
  cp "$CODEX_HOME/config.toml" "$CQA_HOME_ROOT/seed.toml"
  printf 'SEED:\n'
  python3 -c 'import os,pathlib; print(pathlib.Path(os.environ["CODEX_HOME"], "config.toml").read_text(), end="")'
  printf 'COMMAND: node packages/omo-codex/plugin/scripts/migrate-codex-config.mjs\n'
  (cd "$QA_CWD" && node "$REPO_ROOT/packages/omo-codex/plugin/scripts/migrate-codex-config.mjs")
  echo MIGRATION_EXIT=$?
  bun -e 'import assert from "node:assert/strict"; const text=await Bun.file(`${process.env.CODEX_HOME}/config.toml`).text(); const c=Bun.TOML.parse(text); const expected=process.env.FIX4B_MODE === "managed" ? [undefined,undefined] : [16,8]; assert.deepEqual([c.agents?.max_threads,c.features?.multi_agent_v2?.max_concurrent_threads_per_session],expected); assert.equal(c.agents.max_depth,4); console.log("MIGRATED_CONFIG:\n"+text); console.log("MIGRATION_CAP_ASSERTIONS=PASS");'
  cp "$CQA_HOME_ROOT/seed.toml" "$CODEX_HOME/config.toml"
  printf 'COMMAND: cqa_install_local_omo (regenerated bundle)\n'
  set +e
  cqa_install_local_omo
  rc=$?
  set -e
  printf 'INSTALL_EXIT=%s\n' "$rc"
  python3 -c 'import os,pathlib; print(pathlib.Path(os.environ["CQA_HOME_ROOT"], "install.log").read_text(), end="")'
  [ "$rc" = 0 ]
  bun -e 'import assert from "node:assert/strict"; const text=await Bun.file(`${process.env.CODEX_HOME}/config.toml`).text(); const c=Bun.TOML.parse(text); const expected=process.env.FIX4B_MODE === "managed" ? [undefined,undefined] : [16,8]; assert.deepEqual([c.agents?.max_threads,c.features?.multi_agent_v2?.max_concurrent_threads_per_session],expected); assert.equal(c.agents.max_depth,4); assert.equal(c.plugins["omo@sisyphuslabs"].enabled,true); if(process.env.FIX4B_MODE === "user") assert.equal(c.features.multi_agent_v2.enabled,false); console.log("INSTALLED_CAPS="+JSON.stringify({agents:c.agents.max_threads ?? null,v2:c.features?.multi_agent_v2?.max_concurrent_threads_per_session ?? null,max_depth:c.agents.max_depth,plugin_enabled:c.plugins["omo@sisyphuslabs"].enabled})); console.log("INSTALL_CAP_ASSERTIONS=PASS");'
  cqa_assert_real_home_unchanged
  root="$CQA_HOME_ROOT"
  cqa_cleanup
  test ! -e "$root"
  printf 'dir REMOVED: %s\n' "$root"
done
cqa_assert_real_home_unchanged
printf 'REAL_CONFIG_SHA1_AFTER=%s\n' "$(shasum "$HOME/.codex/config.toml" | awk '{print $1}')"
printf 'MANUAL_QA_EXIT=0\n'
