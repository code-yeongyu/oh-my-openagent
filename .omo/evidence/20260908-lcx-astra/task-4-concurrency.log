printf 'PRESERVATION_INSTALL_EXIT=0\n'
rg -n '^max_concurrent_threads_per_session = 4$' "$CODEX_HOME/config.toml"
cqa_assert_real_home_unchanged
cqa_cleanup
[ ! -e "$happy_root" ] && printf '%s dir REMOVED\n' "$happy_root"
[ ! -e "$preserve_root" ] && printf '%s dir REMOVED\n' "$preserve_root"

