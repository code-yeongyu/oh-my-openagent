cqa_mk_isolated_home
happy_root="$CQA_HOME_ROOT"
printf '%s\n' '[features.multi_agent_v2]' 'max_concurrent_threads_per_session = 1000' '[agents]' 'max_threads = 1000' > "$CODEX_HOME/config.toml"
printf 'HAPPY_SEED\n'; cat "$CODEX_HOME/config.toml"
REPO_ROOT="$PWD" cqa_install_local_omo
printf 'HAPPY_INSTALL_EXIT=0\n'
if rg -n 'max_threads|max_concurrent' "$CODEX_HOME/config.toml"; then
  printf 'FAIL: managed caps remain\n'; exit 1
else
  [ "$?" -eq 1 ]; printf 'HAPPY_CAP_MATCHES=0\n'
fi
cqa_assert_real_home_unchanged
cqa_mk_isolated_home
