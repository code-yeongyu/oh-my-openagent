[2K[0m]8;; [38;5;222m[1m[2026.9.2-2] - 2026-09-02[22m[39m                                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mAdded[22m[39m                                                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mClaude Mythos 5 and Mythos 5.1 model ids now route to the matching Claude Fable prompt presets (Anthropic ships one  [0m]8;;
[2K[0m]8;;   prompting guide per Fable/Mythos release pair), instead of falling back to the default dynamic prompt.               [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mChanged[22m[39m                                                                                                            [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mThe [38;5;109mclaude-fable-5-1[39m prompt preset was dieted per the full Anthropic guide set: duplicated scope/stop/evidence rules [0m]8;;
[2K[0m]8;;   are stated once (scope now has its own section), model-default style traits are removed, and the Fable 5 delegation  [0m]8;;
[2K[0m]8;;   guidance plus the 5.1 ask-after-independent-work clause are added. The rendered static core shrinks about 16%.       [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mFixed[22m[39m                                                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mmodels.json custom models under extension-registered providers now inherit the extension's provider-level [38;5;109mapi[39m and    [0m]8;;
[2K[0m]8;;   [38;5;109mbaseUrl[39m, while extension catalog models remain available alongside new custom models.                                [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mClaude SDK OAuth compaction retries that forbid tool calls now send a genuinely tool-less request, preventing        [0m]8;;
[2K[0m]8;;   host-denied tool calls from producing an empty summary.                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mManual [38;5;109m/compact[39m now recovers through the deterministic no-LLM fallback for classified summarizer failures, while     [0m]8;;
[2K[0m]8;;   unclassified failures remain fail-closed.                                                                            [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mNew Features[22m[39m                                                                                                       [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mBreaking Changes[22m[39m                                                                                                   [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mAdded[22m[39m                                                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mChanged[22m[39m                                                                                                            [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mThe default provider stream-start timeout rises from 90s to 300s ([38;5;109mretry.provider.streamStartTimeoutMs[39m overrides are  [0m]8;;
[2K[0m]8;;   unchanged, and the default still never exceeds the idle timeout), so Opus/Fable-class models with long thinking no   [0m]8;;
[2K[0m]8;;   longer fail healthy requests with [38;5;109mProvider stream start timed out after 90000ms[39m before the first stream event; every [0m]8;;
[2K[0m]8;;   comparable harness (opencode, codex, oh-my-pi) already grants 300s here. The agent-level retry budget also rises     [0m]8;;
[2K[0m]8;;   from 3 to 5 attempts: [38;5;109mSENPI_DEFAULT_RETRY_PROFILE.turn.maxRetries[39m and the [38;5;109mretry.maxRetries[39m settings default now      [0m]8;;
[2K[0m]8;;   agree, so the documented default is the budget every consumer actually sees (session-title retry stays clamped by    [0m]8;;
[2K[0m]8;;   its own cap).                                                                                                        [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mFixed[22m[39m                                                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mProvider retry continuation watchdog messages now name [38;5;109mretry.provider.streamStartTimeoutMs[39m; claude-sdk-oauth         [0m]8;;
[2K[0m]8;;   regression coverage pins SDK [38;5;109mapi_retry[39m as stream liveness on query and resident paths.                               [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mRemoved[22m[39m                                                                                                            [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m[2026.9.2] - 2026-09-02[22m[39m                                                                                                [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mAdded[22m[39m                                                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mClaude Fable 5.1 gets its own system prompt preset ([38;5;109mclaude-fable-5-1[39m): the dieted Fable 5 core plus surgical deltas  [0m]8;;
[2K[0m]8;;   from the Fable 5.1 prompting guide (scope-is-the-deliverable, per-response tool-call batching, surgical-edit         [0m]8;;
[2K[0m]8;;   preference, test-scope discipline, and formatting/narration recalibration). The dotted release resolves before the   [0m]8;;
[2K[0m]8;;   generic [38;5;109mfable-5[39m matcher, [38;5;109mpromptPreset: "claude-fable-5-1"[39m can force it, and the fable default lanes now point at     [0m]8;;
[2K[0m]8;;   5.1: the recommended default model, the shipped fallback chain (the [38;5;109mclaude-fable-5[39m chain stays for sessions still on [0m]8;;
[2K[0m]8;;   it), the startup tip, and doc examples.                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mFixed[22m[39m                                                                                                              [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mThe shared RPC host now starts on Windows: socket endpoints resolve to [38;5;109m\\.\pipe\[39m named-pipe addresses derived from a [0m]8;;
[2K[0m]8;;   per-endpoint secret (stored [38;5;109m0600[39m beside the logical path) with a constant-time authenticated handshake gating both   [0m]8;;
[2K[0m]8;;   the public and internal listeners, pidfile ownership proof no longer depends on MSYS [38;5;109mps[39m, logical-path filesystem     [0m]8;;
[2K[0m]8;;   cleanup is skipped for named pipes, and detached supervisor/daemon startup failures no longer leak live children or  [0m]8;;
[2K[0m]8;;   signal reused PIDs. POSIX transports keep the prior unix-socket + [38;5;109m0600[39m behavior.                                     [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39m[38;5;109m/quit[39m and [38;5;109m/exit[39m submitted while startup is still finishing (managed-tool downloads) now quit instead of being parked [0m]8;;
[2K[0m]8;;   back in the editor behind a "Startup is still in progress" notice. Parking the text also disabled the Ctrl+D quit    [0m]8;;
[2K[0m]8;;   escape, which only fires on an empty editor, so the usual way out was a dead end until the line was cleared by hand. [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mAn extension calling [38;5;109mctx.shutdown()[39m while the session is idle now shuts down immediately instead of waiting for an   [0m]8;;
[2K[0m]8;;   [38;5;109magent_settled[39m event that an idle session never emits, which previously stranded the request until the user happened  [0m]8;;
[2K[0m]8;;   to run another turn.                                                                                                 [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mInteractive quit now keeps stderr capture installed while session shutdown handlers drain during runtime disposal,   [0m]8;;
[2K[0m]8;;   so shutdown-time diagnostics (for example memory drain warnings) are recorded in the debug log instead of printing   [0m]8;;
[2K[0m]8;;   raw beside the resume hint. The TUI still stops first to avoid final-frame repaints, and stderr is restored after    [0m]8;;
[2K[0m]8;;   disposal even when disposal fails.                                                                                   [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mMulti-session RPC hosts launched with [38;5;109mSENPI_RPC_CLIENT_CAPABILITIES[39m (for example [38;5;109mextension_events[39m) now apply those   [0m]8;;
[2K[0m]8;;   capabilities to connection-owned session bindings when the client never sends [38;5;109mset_client_info[39m. Previously the launch [0m]8;;
[2K[0m]8;;   capabilities were advertised through [38;5;109mget_protocol_info[39m but dropped at binding creation, so undeclared clients        [0m]8;;
[2K[0m]8;;   received no [38;5;109mextension_event[39m frames (breaking downstream task/DAG/monitor liveness in omo-desktop-app). An explicit   [0m]8;;
[2K[0m]8;;   [38;5;109mset_client_info[39m declaration, including an empty capability list, still overrides the launch default.                 [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mRPC [38;5;109mabort[39m acknowledgements are now sent immediately after the abort signal is dispatched instead of waiting for full [0m]8;;
[2K[0m]8;;   session quiescence, preventing desktop stop requests from hitting their 10-second bounded-ack timeout under host     [0m]8;;
[2K[0m]8;;   load.                                                                                                                [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mNew Features[22m[39m                                                                                                       [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;109m- [39mRPC clients can opt into native session auto-titles with the [38;5;109mauto_title_sessions[39m capability; supported RPC sessions  [0m]8;;
[2K[0m]8;;   generate and emit their title through [38;5;109msession_info_changed[39m.                                                          [0m]8;;
[2K[0m]8;;                                                                                                                        [0m]8;;
[2K[0m]8;; [38;5;222m[1m### [22m[39m[38;5;222m[1mBreaking Changes[22m[39m                                                                                                   [0m]8;;
