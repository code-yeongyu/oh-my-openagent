{
  "description": "capture reports sourceWidth/sourceHeight and a frame id, honors maxWidth, and degrades to artifact-only when the inline byte budget cannot hold the image.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/two-displays-one-window.json",
  "env": {},
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "capture",
        "params": {
          "target": "desktop",
          "caps": {
            "maxWidth": 640
          }
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "mode": "inline-png",
              "data": "iVBORw0KGgo=",
              "mimeType": "image/png",
              "artifactPath": null,
              "width": 640,
              "height": 360,
              "sourceWidth": 2560,
              "sourceHeight": 1440,
              "scale": 0.25,
              "target": "desktop",
              "frameId": "frame-1",
              "note": null
            }
          },
          "variable": [
            "/result/data",
            "/result/height",
            "/result/sourceWidth",
            "/result/sourceHeight",
            "/result/scale",
            "/result/frameId"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "capture",
        "params": {
          "target": "desktop",
          "caps": {
            "maxWidth": 640,
            "maxBytes": 1
          }
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "mode": "artifact-only",
              "data": null,
              "mimeType": "image/png",
              "artifactPath": "/tmp/senpi-desktop/frame-2.png",
              "width": 640,
              "height": 360,
              "sourceWidth": 2560,
              "sourceHeight": 1440,
              "scale": 0.25,
              "target": "desktop",
              "frameId": "frame-1",
              "note": "over the inline budget"
            }
          },
          "variable": [
            "/result/height",
            "/result/sourceWidth",
            "/result/sourceHeight",
            "/result/scale",
            "/result/frameId",
            "/result/mimeType",
            "/result/artifactPath",
            "/result/note"
          ]
        }
      ]
    }
  ]
}
