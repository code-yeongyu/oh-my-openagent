{
  "description": "computer-use v2 epoch (row 14) null-mode control: the epoch-change scenario without reportMode keeps protocol 1 behavior: no epoch.changed notification, the click on the frame captured before the display reconfiguration answers null and the ref read before it still resolves.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/v2-epoch-display.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true,
          "showCursor": false
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "ax.focused",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "result": {
              "ref": "e1",
              "role": "textarea",
              "nativeRole": "AXTextArea",
              "title": null,
              "value": "",
              "description": null,
              "enabled": true,
              "focused": true,
              "x": 110.0,
              "y": 160.0,
              "width": 780.0,
              "height": 500.0,
              "actions": [
                "focus"
              ],
              "childCount": 0
            }
          },
          "variable": [],
          "bind": {
            "ref": "/result/ref"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "capture",
        "params": {
          "target": "101"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "result": {
              "mode": "inline-png",
              "data": "",
              "mimeType": "image/png",
              "artifactPath": null,
              "width": 800,
              "height": 600,
              "sourceWidth": 800,
              "sourceHeight": 600,
              "coordinateWidth": 800,
              "coordinateHeight": 600,
              "region": null,
              "scale": 1.0,
              "target": "101",
              "frameId": "frame-01m6nstn5s75cem9z3yxd089zw-1",
              "note": null
            }
          },
          "variable": [
            "/result/data",
            "/result/frameId"
          ],
          "bind": {
            "frame": "/result/frameId"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "click",
        "params": {
          "target": "101",
          "x": 20.0,
          "y": 20.0,
          "frameId": "{{frame}}"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 7,
            "result": null
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "click",
              "target": "101",
              "delivery": "background",
              "frameId": "frame-01m6nstn5s75cem9z3yxd089zw-1",
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/frameId"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "ax.node",
        "params": {
          "ref": "{{ref}}"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 8,
            "result": {
              "ref": "e1",
              "role": "textarea",
              "nativeRole": "AXTextArea",
              "title": null,
              "value": "",
              "description": null,
              "enabled": true,
              "focused": true,
              "x": 110.0,
              "y": 160.0,
              "width": 780.0,
              "height": 500.0,
              "actions": [
                "focus"
              ],
              "childCount": 0
            }
          },
          "variable": []
        }
      ]
    }
  ]
}
