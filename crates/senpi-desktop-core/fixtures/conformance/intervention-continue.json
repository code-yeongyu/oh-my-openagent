{
  "description": "computer-use v2 row 19 (DESIGN 7, Q decision 1), reportMode object with intervention continue over intervention-continue.json, whose user presses a key in Notes (pid 4242) right before the first key of a typeText: with a live host-relay stop path the typeText of 10 scalars is not stopped by the user's key and reports delivered {count: 10, of: 10}; the session's record still counts the key (session test policy_tests).",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/intervention-continue.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true,
          "showCursor": false,
          "reportMode": "object",
          "intervention": "continue"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "typeText",
        "params": {
          "target": "101",
          "text": "abcdefghij"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": {
              "disposition": {
                "delivery": "delivered_unverified",
                "retry": "unsafe"
              },
              "delivered": {
                "count": 10,
                "of": 10
              },
              "effect": "unverifiable",
              "route": "background_window",
              "focusRestoration": "restored",
              "auditIds": [
                "audit-id"
              ]
            }
          },
          "variable": [
            "/result/auditIds",
            "/result/focusRestoration"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": true,
              "textLength": 10,
              "textDelivered": 10,
              "textSha256": "72399361da6a7754",
              "keys": null,
              "id": "audit-id"
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/id"
          ]
        }
      ]
    }
  ]
}
