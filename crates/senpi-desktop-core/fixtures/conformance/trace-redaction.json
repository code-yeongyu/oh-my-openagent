{
  "description": "trace: true (computer-use v2 P13a): engine.hello lists the trace feature; in a session opened with trace, every action report carries per-stage timings; a click on a secure text field reports hit.label null, and typing a secret into it returns and audits only its length and hash, never the text.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/v2-trace-secure-field.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "engine.hello",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocolVersion": "1",
              "engineVersion": "0.0.0",
              "buildSha": "unknown",
              "abi": "senpi-desktop/1",
              "features": [
                "action-report",
                "frame-identity",
                "frame-consume",
                "ax-partial",
                "trace",
                "key-priming",
                "epoch",
                "interaction-lock"
              ]
            }
          },
          "variable": [
            "/result/engineVersion",
            "/result/buildSha"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true,
          "showCursor": false,
          "reportMode": "object",
          "trace": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "TOKEN"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "capture",
        "params": {
          "target": "101"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "result": {
              "mode": "inline-png",
              "data": "<png>",
              "mimeType": "image/png",
              "artifactPath": null,
              "width": 800,
              "height": 600,
              "sourceWidth": 800,
              "sourceHeight": 600,
              "coordinateWidth": 800,
              "coordinateHeight": 600,
              "region": null,
              "scale": 1.0,
              "target": "101",
              "frameId": "frame-1",
              "note": null,
              "identity": {
                "windowNumber": "101",
                "pid": 4242,
                "processStart": 1700000000
              }
            }
          },
          "variable": [
            "/result/data",
            "/result/frameId"
          ],
          "bind": {
            "frame": "/result/frameId"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "click",
        "params": {
          "target": "101",
          "x": 20.0,
          "y": 20.0,
          "frameId": "{{frame}}"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "result": {
              "disposition": {
                "delivery": "delivered_unverified",
                "retry": "unsafe"
              },
              "effect": "unverifiable",
              "route": "background_window",
              "hit": {
                "role": "textfield",
                "label": null
              },
              "focusRestoration": "not_needed",
              "timings": {
                "dispatch": 0
              },
              "auditIds": [
                "AUDIT"
              ]
            }
          },
          "variable": [
            "/result/timings",
            "/result/auditIds/0"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "click",
              "target": "101",
              "delivery": "background",
              "frameId": "frame-1",
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null,
              "id": "AUDIT"
            }
          },
          "variable": [
            "/params/id",
            "/params/durationMs",
            "/params/frameId"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "typeText",
        "params": {
          "target": "101",
          "text": "hunter2-trace-secret-7731"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 7,
            "result": {
              "disposition": {
                "delivery": "delivered_unverified",
                "retry": "unsafe"
              },
              "delivered": {
                "count": 25,
                "of": 25
              },
              "effect": "unverifiable",
              "route": "background_window",
              "focusRestoration": "restored",
              "timings": {
                "dispatch": 0
              },
              "auditIds": [
                "AUDIT"
              ]
            }
          },
          "variable": [
            "/result/timings",
            "/result/auditIds/0"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": true,
              "textLength": 25,
              "textDelivered": 25,
              "textSha256": "3ad2562c96f04807",
              "keys": null,
              "id": "AUDIT"
            }
          },
          "variable": [
            "/params/id",
            "/params/durationMs"
          ]
        }
      ]
    }
  ]
}
