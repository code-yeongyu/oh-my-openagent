{
  "description": "apps.list (#11463) is a public read and apps.open a public exec method (plan D5): with a live host-relay stop path and no control.grant, listing the inventory and opening Notes in the background succeed (the open is audited as background and returns the window it shows); apps.open with activate is refused ControlRequired before anything launches and audited as foreground; an unknown application is InvalidTarget; after control.grant the same activate open succeeds and is audited as foreground.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/two-displays-one-window.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true,
          "showCursor": false
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": false,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": false,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "apps.list",
        "params": {
          "query": "notes"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": [
              {
                "id": "Notes",
                "name": "Notes",
                "path": "/Applications/Notes.app",
                "running": true,
                "pid": 4242
              }
            ]
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "apps.open",
        "params": {
          "id": "Notes"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "result": {
              "id": "Notes",
              "name": "Notes",
              "path": "/Applications/Notes.app",
              "running": true,
              "pid": 4242,
              "window": {
                "id": "101",
                "title": "Untitled - Notes",
                "app": "Notes",
                "pid": 4242,
                "x": 100,
                "y": 120,
                "width": 800,
                "height": 600,
                "focused": true,
                "elevated": null
              }
            }
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "apps.open",
              "target": "Notes",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "apps.open",
        "params": {
          "id": "Notes",
          "activate": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "error": {
              "code": -32022,
              "message": "opening an application in front (activate) or revealing an item in Finder takes your foreground: open it in the background instead, or approve the grant (computer.control.acquire asks the human first); nothing was launched",
              "data": {
                "code": "ControlRequired",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message",
            "/error/data/hint"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "apps.open",
              "target": "Notes",
              "delivery": "foreground",
              "frameId": null,
              "code": "ControlRequired",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "apps.open",
        "params": {
          "id": "Nope"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 7,
            "error": {
              "code": -32005,
              "message": "application \"Nope\" was not found; use apps.list() or an existing native application path",
              "data": {
                "code": "InvalidTarget",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message",
            "/error/data/hint"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "apps.open",
              "target": "Nope",
              "delivery": "background",
              "frameId": null,
              "code": "InvalidTarget",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "control.grant",
        "params": {
          "confirmationId": "conf-1",
          "reason": "open Notes in front"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 8,
            "result": {
              "active": true,
              "reason": "open Notes in front",
              "grantedAt": "2026-10-28T20:01:47.845Z"
            }
          },
          "variable": [
            "/result/grantedAt"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "control.grant",
              "target": "control",
              "delivery": "control",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 19,
              "textSha256": "896cdf20728fe4af",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "apps.open",
        "params": {
          "id": "Notes",
          "activate": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 9,
            "result": {
              "id": "Notes",
              "name": "Notes",
              "path": "/Applications/Notes.app",
              "running": true,
              "pid": 4242,
              "window": {
                "id": "101",
                "title": "Untitled - Notes",
                "app": "Notes",
                "pid": 4242,
                "x": 100,
                "y": 120,
                "width": 800,
                "height": 600,
                "focused": true,
                "elevated": null
              }
            }
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "apps.open",
              "target": "Notes",
              "delivery": "foreground",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    }
  ]
}
