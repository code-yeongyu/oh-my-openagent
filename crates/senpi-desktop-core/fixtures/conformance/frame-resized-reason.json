{
  "description": "computer-use v2 P6, reportMode object: window 101 is resized after its capture, so a click on that frame is refused InvalidCoordinateFrame reason resized, not_delivered/safe.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/v2-frame-resized.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true,
          "showCursor": false,
          "reportMode": "object"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "capture",
        "params": {
          "target": "101"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "result": {
              "mode": "inline-png",
              "data": "",
              "mimeType": "image/png",
              "artifactPath": null,
              "width": 800,
              "height": 600,
              "sourceWidth": 800,
              "sourceHeight": 600,
              "coordinateWidth": 800,
              "coordinateHeight": 600,
              "region": null,
              "scale": 1.0,
              "target": "101",
              "frameId": "frame-01m6n3mxy3y8jjh6k6x0gvdxyp-1",
              "note": null,
              "identity": {
                "windowNumber": "101",
                "pid": 4242,
                "processStart": 1700000000
              }
            }
          },
          "variable": [
            "/result/data",
            "/result/frameId"
          ],
          "bind": {
            "frame": "/result/frameId"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "click",
        "params": {
          "target": "101",
          "x": 20.0,
          "y": 20.0,
          "frameId": "{{frame}}"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "error": {
              "code": -32007,
              "message": "target window was resized since capture; capture it again before coordinate input",
              "data": {
                "code": "InvalidCoordinateFrame",
                "hint": null,
                "reason": "resized",
                "disposition": {
                  "delivery": "not_delivered",
                  "retry": "safe"
                },
                "focusRestoration": "not_needed"
              }
            }
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "click",
              "target": "101",
              "delivery": "background",
              "frameId": "frame-01m6n3mxy3y8jjh6k6x0gvdxyp-1",
              "code": "InvalidCoordinateFrame",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null,
              "id": "01M6N3MZ8MHDBADWVM8CGWJY1B"
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/id",
            "/params/frameId"
          ]
        }
      ]
    }
  ]
}
