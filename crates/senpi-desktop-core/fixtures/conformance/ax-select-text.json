{
  "description": "ax.selectText selects a unique, context-disambiguated range inside an element's value by writing its selected text range (UTF-16 offsets; no key sent, no focus moved): an unanswered write (-32025 AxUnconfirmed) still lands, the applied selection comes back with its text, and a following ax.typeText replaces it (parity row E-2); the audit carries the searched text's length and hash.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/ax-select-text.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "ax.snapshot",
        "params": {
          "target": "101"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": {
              "text": "- window \"Untitled - Notes\" [ref=e1] app=Notes (focused)\n  - textarea [ref=e2] (focused)\n  - button \"Save\" [ref=e3]",
              "nodeCount": 3,
              "truncated": false
            }
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "ax.setValue",
        "params": {
          "ref": "e2",
          "value": "alpha beta gamma"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "result": null
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "ax.setValue",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 16,
              "textDelivered": 0,
              "textSha256": "64989ccbf3efa9c8",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "ax.selectText",
        "params": {
          "ref": "e2",
          "text": "beta",
          "prefix": "alpha "
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "error": {
              "code": -32025,
              "message": "setting the selected text range was requested, but its outcome could not be confirmed: the fake app did not reply (injected ax_cannot_complete). It may already have taken effect: observe the window before retrying",
              "data": {
                "code": "AxUnconfirmed",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message",
            "/error/data/hint"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "ax.selectText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": "AxUnconfirmed",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 4,
              "textDelivered": 0,
              "textSha256": "f44e64e75f3948e9",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "ax.selectText",
        "params": {
          "ref": "e2",
          "text": "beta",
          "prefix": "alpha "
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 7,
            "result": {
              "start": 6,
              "length": 4,
              "text": "beta",
              "focused": true
            }
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "ax.selectText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 4,
              "textDelivered": 0,
              "textSha256": "f44e64e75f3948e9",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "ax.typeText",
        "params": {
          "ref": "e2",
          "text": "BETA"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 8,
            "result": {
              "method": "inserted"
            }
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "ax.typeText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": true,
              "textLength": 4,
              "textDelivered": 4,
              "textSha256": "639181fd63cbad6e",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "ax.node",
        "params": {
          "ref": "e2"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 9,
            "result": {
              "ref": "e2",
              "role": "textarea",
              "nativeRole": "AXTextArea",
              "title": null,
              "value": "alpha BETA gamma",
              "description": null,
              "enabled": true,
              "focused": true,
              "x": 110.0,
              "y": 160.0,
              "width": 780.0,
              "height": 500.0,
              "actions": [
                "focus"
              ],
              "childCount": 0
            }
          },
          "variable": []
        }
      ]
    }
  ]
}
