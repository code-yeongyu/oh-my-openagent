{
  "description": "Physical Escape cancels takeover, revokes ownership and notifies; automatic background input stays unarmed (#11465).",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/escape-stop.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "control.grant",
        "params": {
          "reason": "already allowed",
          "confirmationId": "automatic-1",
          "automatic": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": {
              "active": true,
              "reason": "already allowed",
              "grantedAt": "2026-10-29T00:00:00.000Z",
              "escapeStops": 0
            }
          },
          "variable": [
            "/result/grantedAt"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "control.grant",
              "target": "control",
              "delivery": "control",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 15,
              "textSha256": "8d980e016be03ef8",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "typeText",
        "params": {
          "target": "101",
          "text": "abcdefghijklmnop",
          "opts": {
            "deliveryMode": "foreground"
          }
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "error": {
              "code": -32017,
              "message": "cancelled",
              "data": {
                "code": "Cancelled",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "escape.stopped",
            "params": {
              "escapeStops": 1
            }
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "101",
              "delivery": "foreground",
              "frameId": null,
              "code": "Cancelled",
              "durationMs": 0,
              "focusRestored": true,
              "textLength": 16,
              "textDelivered": 8,
              "textSha256": "f39dac6cbaba535e",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "control.state",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "result": {
              "active": false,
              "escapeStops": 1
            }
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "control.grant",
        "params": {
          "reason": "next user turn",
          "confirmationId": "automatic-2",
          "automatic": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 7,
            "result": {
              "active": true,
              "reason": "next user turn",
              "grantedAt": "2026-10-29T00:00:00.000Z",
              "escapeStops": 1
            }
          },
          "variable": [
            "/result/grantedAt"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "control.grant",
              "target": "control",
              "delivery": "control",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 14,
              "textSha256": "864df922a6299613",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "typeText",
        "params": {
          "target": "101",
          "text": "background"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 8,
            "result": null
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": true,
              "textLength": 10,
              "textDelivered": 10,
              "textSha256": "89b91df19d9d75d4",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "control.state",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 9,
            "result": {
              "active": true,
              "reason": "next user turn",
              "grantedAt": "2026-10-29T00:00:00.000Z",
              "escapeStops": 1
            }
          },
          "variable": [
            "/result/grantedAt"
          ]
        }
      ]
    }
  ]
}
