{
  "description": "computer-use v2 P6, reportMode object: window 101's process quits after the capture and a new process (pid 5151) takes its window number; a click on the old frame is refused WindowNotFound reason identity_changed, not_delivered/safe, before any input is posted; windows then names the new owner.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/v2-frame-identity-changed.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true,
          "showCursor": false,
          "reportMode": "object"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "capture",
        "params": {
          "target": "101"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "result": {
              "mode": "inline-png",
              "data": "",
              "mimeType": "image/png",
              "artifactPath": null,
              "width": 800,
              "height": 600,
              "sourceWidth": 800,
              "sourceHeight": 600,
              "coordinateWidth": 800,
              "coordinateHeight": 600,
              "region": null,
              "scale": 1.0,
              "target": "101",
              "frameId": "frame-01m6n3mn1q7xphr5cp6n975bxy-1",
              "note": null,
              "identity": {
                "windowNumber": "101",
                "pid": 4242,
                "processStart": 1700000000
              }
            }
          },
          "variable": [
            "/result/data",
            "/result/frameId"
          ],
          "bind": {
            "frame": "/result/frameId"
          }
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "click",
        "params": {
          "target": "101",
          "x": 20.0,
          "y": 20.0,
          "frameId": "{{frame}}"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "error": {
              "code": -32004,
              "message": "the captured window now belongs to another process; find the window again before coordinate input",
              "data": {
                "code": "WindowNotFound",
                "hint": null,
                "reason": "identity_changed",
                "disposition": {
                  "delivery": "not_delivered",
                  "retry": "safe"
                },
                "focusRestoration": "not_needed"
              }
            }
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "windows",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "click",
              "target": "101",
              "delivery": "background",
              "frameId": "frame-01m6n3mn1q7xphr5cp6n975bxy-1",
              "code": "WindowNotFound",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null,
              "id": "01M6N3MP689SW3N935WHRJWT71"
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/id",
            "/params/frameId"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 9,
            "result": [
              {
                "id": "101",
                "title": "Untitled - Notes",
                "app": "Notes",
                "pid": 5151,
                "x": 100,
                "y": 120,
                "width": 800,
                "height": 600,
                "focused": false,
                "elevated": null,
                "identity": {
                  "windowNumber": "101",
                  "pid": 5151,
                  "processStart": 1700000999
                }
              }
            ]
          },
          "variable": []
        }
      ]
    }
  ]
}
