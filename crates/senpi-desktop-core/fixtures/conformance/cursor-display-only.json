{
  "description": "session.open accepts an explicit cursor-off display preference and capabilities reports overlay availability without changing admission fields.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/two-displays-one-window.json",
  "env": {},
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {
          "showCursor": false
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "raiseWindow",
        "params": {
          "windowId": "101"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32014,
              "message": "StopPathUnavailable",
              "data": {
                "code": "StopPathUnavailable",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message",
            "/error/data/hint"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "raiseWindow",
              "target": "101",
              "delivery": "foreground",
              "frameId": null,
              "code": "StopPathUnavailable",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": null,
              "textSha256": null,
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    }
  ]
}
