{
  "description": "typeText into a window that shows a remote screen (Screen Sharing: key events, modifiers from the physical keyboard; iPhone Mirroring: HID reports): every character is mapped to a key of the layout before anything is sent, so a character no key types is refused InvalidKey with nothing typed; in the background a Screen Sharing window refuses text that needs Shift (BackgroundUnavailable, nothing sent) while unshifted text and iPhone Mirroring text go out as keys; the audit carries length, delivered count and hash.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/remote-typing.json",
  "env": {
    "SENPI_DESKTOP_FAKE_CLOCK": "1"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {
          "allowHostRelayOnlyStop": true
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": false,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "host-relay",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "stopPath.heartbeat",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "typeText",
        "params": {
          "target": "101",
          "text": "ab😀c"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "error": {
              "code": -32006,
              "message": "",
              "data": {
                "code": "InvalidKey",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message",
            "/error/data/hint"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": "InvalidKey",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 4,
              "textDelivered": 0,
              "textSha256": "fbd496c6039564c2",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/frameId"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "typeText",
        "params": {
          "target": "101",
          "text": "Hello"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "error": {
              "code": -32003,
              "message": "",
              "data": {
                "code": "BackgroundUnavailable",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message",
            "/error/data/hint"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": "BackgroundUnavailable",
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 5,
              "textDelivered": 0,
              "textSha256": "185f8db32271fe25",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/frameId"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "typeText",
        "params": {
          "target": "101",
          "text": "hello"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "result": null
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 5,
              "textDelivered": 5,
              "textSha256": "2cf24dba5fb0a30e",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/frameId"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "typeText",
        "params": {
          "target": "202",
          "text": "Hello World"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 7,
            "result": null
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "202",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": null,
              "textLength": 11,
              "textDelivered": 11,
              "textSha256": "a591a6d40bf42040",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored",
            "/params/frameId"
          ]
        }
      ]
    }
  ]
}
