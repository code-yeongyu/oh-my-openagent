{
  "description": "ErrorCode amendment 2 (computer-use v2 P1a): the appended AmbiguousTarget, CaptureConsentRequired and ProtectedProcess, failed through the fake, are -32028..-32030; every earlier numeric code is unchanged.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/error-codes-amend-2.json",
  "env": {},
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "displays",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32028,
              "message": "injected Displays failure",
              "data": {
                "code": "AmbiguousTarget",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "displays",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "error": {
              "code": -32029,
              "message": "injected Displays failure",
              "data": {
                "code": "CaptureConsentRequired",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "displays",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "error": {
              "code": -32030,
              "message": "injected Displays failure",
              "data": {
                "code": "ProtectedProcess",
                "hint": null
              }
            }
          },
          "variable": [
            "/error/message"
          ]
        }
      ]
    }
  ]
}
