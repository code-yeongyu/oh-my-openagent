{
  "description": "engine.hello reports protocol version 1, ABI senpi-desktop/1 and the opt-in features it supports (P1a: action-report), and echoes number and string ids verbatim; engine version and build sha vary per build.",
  "scenario": "crates/senpi-desktop-backend-fake/fixtures/two-displays-one-window.json",
  "env": {},
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "engine.hello",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocolVersion": "1",
              "engineVersion": "0.0.0",
              "buildSha": "unknown",
              "abi": "senpi-desktop/1",
              "features": [
                "action-report",
                "frame-identity",
                "frame-consume",
                "ax-partial",
                "trace",
                "key-priming",
                "epoch",
                "interaction-lock",
                "intervention-policy"
              ]
            }
          },
          "variable": [
            "/result/engineVersion",
            "/result/buildSha"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": "hello-2",
        "method": "engine.hello",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": "hello-2",
            "result": {
              "protocolVersion": "1",
              "engineVersion": "0.0.0",
              "buildSha": "unknown",
              "abi": "senpi-desktop/1",
              "features": [
                "action-report",
                "frame-identity",
                "frame-consume",
                "ax-partial",
                "trace",
                "key-priming",
                "epoch",
                "interaction-lock",
                "intervention-policy"
              ]
            }
          },
          "variable": [
            "/result/engineVersion",
            "/result/buildSha"
          ]
        }
      ]
    }
  ]
}
