{
  "description": "capture of a window under the default session returns the inline-png result shape with frame-1; the PNG bytes are variable.",
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/two-displays-one-window.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "capture",
        "params": {
          "target": "101",
          "caps": {
            "maxWidth": 64
          }
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "mode": "inline-png",
              "data": "png-bytes",
              "mimeType": "image/png",
              "artifactPath": null,
              "width": 64,
              "height": 48,
              "sourceWidth": 800,
              "sourceHeight": 600,
              "coordinateWidth": 64,
              "coordinateHeight": 48,
              "region": null,
              "scale": 0.08,
              "target": "101",
              "frameId": "frame-1",
              "note": null
            }
          },
          "variable": [
            "/result/data"
          ]
        }
      ]
    }
  ]
}
