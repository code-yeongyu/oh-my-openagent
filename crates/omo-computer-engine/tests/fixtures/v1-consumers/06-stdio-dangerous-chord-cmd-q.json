{
  "description": "the dangerous chord cmd+q is delivered to a window today: result null and an audit naming the keys.",
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/two-displays-one-window.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "keyChord",
        "params": {
          "target": "101",
          "keys": [
            "cmd",
            "q"
          ]
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "keyChord",
              "target": "101",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": true,
              "textLength": null,
              "textSha256": null,
              "keys": [
                "cmd",
                "q"
              ]
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    }
  ]
}
