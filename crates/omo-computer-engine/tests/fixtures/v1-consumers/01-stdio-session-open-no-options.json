{
  "description": "session.open with no options (the v1 host shape) answers the engine-default capabilities and a resume token; capabilities reads back the same defaults.",
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/two-displays-one-window.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "capabilities",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "backend": "fake",
              "displayServer": null,
              "capture": true,
              "input": true,
              "ax": true,
              "backgroundWindowInput": true,
              "cursorOverlay": false,
              "deliveryModes": [
                "background",
                "foreground"
              ],
              "capturePermission": "granted",
              "inputPermission": "granted",
              "axPermission": "granted",
              "displayCount": 2,
              "focusGuard": true,
              "stopPath": "none",
              "stopReason": "no-global-listener",
              "integrityLevel": null,
              "screenLocked": false,
              "displayAsleep": false
            }
          },
          "variable": []
        }
      ]
    }
  ]
}
