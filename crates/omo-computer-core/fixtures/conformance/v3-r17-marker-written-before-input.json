{
  "description": "A delivered click leaves its pre-input marker at markers/local/default.json under the case's runtime dir; the marker names the case's callId and carries the stored receipt. The driver gives the case a fresh, empty runtime dir, so no marker of this callId exists before the run.",
  "supersedes": [
    "v3-marker-written-before-input.json"
  ],
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/two-displays-one-window.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": false,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/result/globalLive",
            "/result/heartbeatFresh",
            "/result/stopPath",
            "/result/hostRelayLive"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10,
          "callId": "qa-marker-happy"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ]
    }
  ]
}
