{
  "description": "With the fake stop path live, the first click is admitted and its events reach the sink (one click: pointer move, button down, button up), stopPath.stop latches, and the second click answers Suspended with nothing more in the sink.",
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/v3-two-displays-one-window-consent.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ],
      "sink": 0
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": false,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": []
        }
      ],
      "sink": 0
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ],
      "sink": 3
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "stopPath.stop",
        "params": {
          "source": "api"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": {
              "suspended": true,
              "globalLive": true,
              "hostRelayLive": false,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": "api"
            }
          },
          "variable": [
            "/result/globalLive",
            "/result/heartbeatFresh",
            "/result/stopPath"
          ]
        }
      ],
      "sink": 3
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "error": {
              "code": -32015,
              "message": "Suspended",
              "data": {
                "code": "Suspended",
                "hint": null,
                "reason": "api"
              }
            }
          },
          "variable": []
        }
      ],
      "sink": 3
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "error": {
              "code": -32015,
              "message": "Suspended",
              "data": {
                "code": "Suspended",
                "hint": null,
                "reason": "api"
              }
            }
          },
          "variable": []
        }
      ],
      "sink": 3
    }
  ]
}
