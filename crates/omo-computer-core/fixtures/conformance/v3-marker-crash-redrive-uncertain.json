{
  "description": "A call that crashed between its pre-input marker and its reply is never delivered again. The runtime root this case names must hold that crash state before the run: a click with callId k-crash delivered by this engine, whose marker then lost its receipt (the QA command produces it). Every re-drive of k-crash, in one engine and after a restart, answers TransactionFailed{recovery_required, callId} with disposition delivery_uncertain/unsafe and sends nothing; another callId in the scope is delivered; k-crash stays refused after it. The driver counts sinks in its own temp dir, so the QA command counts the sink under this root: 3 lines from the crashed delivery plus 3 from k-next.",
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/two-displays-one-window.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live",
    "OMO_COMPUTER_RUNTIME_DIR": "target/qa-computer-v3/marker-crash-redrive"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": false,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/result/globalLive",
            "/result/heartbeatFresh",
            "/result/stopPath",
            "/result/hostRelayLive"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10,
          "callId": "k-crash"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "error": {
              "code": -32020,
              "message": "TransactionFailed",
              "data": {
                "code": "TransactionFailed",
                "hint": null,
                "reason": "recovery_required",
                "callId": "k-crash",
                "disposition": {
                  "delivery": "delivery_uncertain",
                  "retry": "unsafe"
                }
              }
            }
          },
          "variable": []
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10,
          "callId": "k-crash"
        }
      },
