{
  "description": "Row 21 (AC-97 macOS fake leg): the consent view approved Notes bound to teamId TEAM123456 + cdhash 0123...; the window's process now reads another cdhash under the same app key, so a click answers ControlRequired{identity_changed, app, identity:{approved, observed}} and nothing reaches the sink.",
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/v3-consent-identity-changed.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 1,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ],
      "sink": 0
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": false,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": []
        }
      ],
      "sink": 0
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "error": {
              "code": -32022,
              "message": "ControlRequired",
              "data": {
                "code": "ControlRequired",
                "hint": null,
                "reason": "identity_changed",
                "app": "Notes",
                "identity": {
                  "approved": {
                    "identity": {
                      "teamId": "TEAM123456",
                      "cdhash": "0123456789abcdef0123456789abcdef01234567"
                    }
                  },
                  "observed": {
                    "identity": {
                      "teamId": "TEAM123456",
                      "cdhash": "fedcba9876543210fedcba9876543210fedcba98"
                    }
                  }
                }
              }
            }
          },
          "variable": []
        }
      ],
      "sink": 0
    }
  ]
}
