{
  "description": "On the local stdio transport a click whose callId already completed is a replay: it answers TransactionFailed{reason:\"replayed\", callId, receipt} (the stored null-mode reply) with nothing sent, also after the engine restarts over the same runtime root; a new callId is delivered.",
  "transport": "stdio",
  "scenario": "crates/omo-computer-backend-fake/fixtures/two-displays-one-window.json",
  "env": {
    "OMO_COMPUTER_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ],
      "sink": 0
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": false,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/result/globalLive",
            "/result/heartbeatFresh",
            "/result/stopPath",
            "/result/hostRelayLive"
          ]
        }
      ],
      "sink": 0
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10,
          "callId": "c-1"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        }
      ],
      "sink": 3
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10,
          "callId": "c-1"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "error": {
              "code": -32020,
              "message": "TransactionFailed",
              "data": {
                "code": "TransactionFailed",
                "hint": null,
                "reason": "replayed",
                "callId": "c-1",
                "receipt": null
              }
            }
          },
          "variable": []
        }
      ],
      "sink": 3
    },
    {
      "restart": true
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 5,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": null,
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/capabilities",
            "/result/resumeToken"
          ]
        }
      ],
      "sink": 3
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "stopPath.start",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 6,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": false,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/result/globalLive",
            "/result/heartbeatFresh",
            "/result/stopPath",
            "/result/hostRelayLive"
          ]
        }
      ],
      "sink": 3
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10,
          "callId": "c-1"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 7,
            "error": {
              "code": -32020,
              "message": "TransactionFailed",
              "data": {
                "code": "TransactionFailed",
                "hint": null,
                "reason": "replayed",
                "callId": "c-1",
                "receipt": null
              }
            }
          },
          "variable": []
        }
      ],
      "sink": 3
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "click",
        "params": {
          "target": "101",
          "x": 10,
          "y": 10,
          "callId": "c-2"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 8,
            "result": null
          },
          "variable": []
        }
      ],
      "sink": 6
    }
  ]
}
