{
 "description": "a ref from 3 snapshots ago (e3, from the first of four ax.snapshot reads) still resolves for ax.node in a null-mode session.",
 "transport": "stdio",
 "scenario": "crates/senpi-desktop-backend-fake/fixtures/two-displays-one-window.json",
 "env": {
  "SENPI_DESKTOP_FAKE_STOP_PATH": "live"
 },
 "steps": [
  {
   "send": {
    "jsonrpc": "2.0",
    "id": 1,
    "method": "session.open",
    "params": {}
   },
   "expect": [
    {
     "message": {
      "jsonrpc": "2.0",
      "id": 1,
      "result": {
       "capabilities": {
        "backend": "fake",
        "displayServer": null,
        "capture": true,
        "input": true,
        "ax": true,
        "backgroundWindowInput": true,
        "cursorOverlay": false,
        "deliveryModes": [
         "background",
         "foreground"
        ],
        "capturePermission": "granted",
        "inputPermission": "granted",
        "axPermission": "granted",
        "displayCount": 2,
        "focusGuard": true,
        "stopPath": "none",
        "stopReason": "no-global-listener",
        "integrityLevel": null,
        "screenLocked": false,
        "displayAsleep": false
       },
       "resumeToken": "per-process-random"
      }
     },
     "variable": [
      "/result/resumeToken"
     ]
    }
   ]
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": 2,
    "method": "ax.snapshot",
    "params": {
     "target": "101"
    }
   },
   "expect": [
    {
     "message": {
      "jsonrpc": "2.0",
      "id": 2,
      "result": {
       "text": "- window \"Untitled - Notes\" [ref=e1] app=Notes (focused)\n  - textarea [ref=e2] (focused)\n  - button \"Save\" [ref=e3]",
       "nodeCount": 3,
       "truncated": false
      }
     }
    }
   ]
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": 3,
    "method": "ax.snapshot",
    "params": {
     "target": "101"
    }
   },
   "expect": [
    {
     "message": {
      "jsonrpc": "2.0",
      "id": 3,
      "result": {
       "text": "- window \"Untitled - Notes\" [ref=e4] app=Notes (focused)\n  - textarea [ref=e5] (focused)\n  - button \"Save\" [ref=e6]",
       "nodeCount": 3,
       "truncated": false
      }
     }
    }
   ]
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": 4,
    "method": "ax.snapshot",
    "params": {
     "target": "101"
    }
   },
   "expect": [
    {
     "message": {
      "jsonrpc": "2.0",
      "id": 4,
      "result": {
       "text": "- window \"Untitled - Notes\" [ref=e7] app=Notes (focused)\n  - textarea [ref=e8] (focused)\n  - button \"Save\" [ref=e9]",
       "nodeCount": 3,
       "truncated": false
      }
     }
    }
   ]
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": 5,
    "method": "ax.snapshot",
    "params": {
     "target": "101"
    }
   },
   "expect": [
    {
     "message": {
      "jsonrpc": "2.0",
      "id": 5,
      "result": {
       "text": "- window \"Untitled - Notes\" [ref=e10] app=Notes (focused)\n  - textarea [ref=e11] (focused)\n  - button \"Save\" [ref=e12]",
       "nodeCount": 3,
       "truncated": false
      }
     }
    }
   ]
  },
  {
   "send": {
    "jsonrpc": "2.0",
    "id": 6,
    "method": "ax.node",
    "params": {
     "ref": "e3"
    }
   },
   "expect": [
    {
     "message": {
      "jsonrpc": "2.0",
      "id": 6,
      "result": {
       "ref": "e3",
       "role": "button",
       "nativeRole": "AXButton",
       "title": "Save",
       "value": null,
       "description": null,
       "enabled": true,
       "focused": false,
       "x": 800.0,
       "y": 680.0,
       "width": 80.0,
       "height": 30.0,
       "actions": [
        "press"
       ],
       "childCount": 0
      }
     }
    }
   ]
  }
 ]
}
