{
  "description": "typeText into an unfocused (background) window is delivered in the background with result null, and focus stays on the foreground window.",
  "transport": "stdio",
  "scenario": "crates/senpi-desktop-engine/tests/fixtures/v1-consumers/scenarios/two-windows-one-background.json",
  "env": {
    "SENPI_DESKTOP_FAKE_STOP_PATH": "live"
  },
  "steps": [
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "session.open",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "capabilities": {
                "backend": "fake",
                "displayServer": null,
                "capture": true,
                "input": true,
                "ax": true,
                "backgroundWindowInput": true,
                "cursorOverlay": false,
                "deliveryModes": [
                  "background",
                  "foreground"
                ],
                "capturePermission": "granted",
                "inputPermission": "granted",
                "axPermission": "granted",
                "displayCount": 2,
                "focusGuard": true,
                "stopPath": "none",
                "stopReason": "no-global-listener",
                "integrityLevel": null,
                "screenLocked": false,
                "displayAsleep": false
              },
              "resumeToken": "per-process-random"
            }
          },
          "variable": [
            "/result/resumeToken"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "stopPath.start",
        "params": {
          "chord": "ctrl+alt+shift+escape"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 2,
            "result": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/result/heartbeatFresh",
            "/result/reason"
          ]
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "stopPath.changed",
            "params": {
              "suspended": false,
              "globalLive": true,
              "hostRelayLive": true,
              "heartbeatFresh": true,
              "stopPath": "global",
              "reason": null
            }
          },
          "variable": [
            "/params/heartbeatFresh",
            "/params/reason"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "typeText",
        "params": {
          "target": "102",
          "text": "ls\n"
        }
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": null
          },
          "variable": []
        },
        {
          "message": {
            "jsonrpc": "2.0",
            "method": "audit",
            "params": {
              "action": "typeText",
              "target": "102",
              "delivery": "background",
              "frameId": null,
              "code": null,
              "durationMs": 0,
              "focusRestored": true,
              "textLength": 3,
              "textDelivered": 3,
              "textSha256": "e9fe7e88e89d5323",
              "keys": null
            }
          },
          "variable": [
            "/params/durationMs",
            "/params/focusRestored"
          ]
        }
      ]
    },
    {
      "send": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "windows",
        "params": {}
      },
      "expect": [
        {
          "message": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": [
              {
                "id": "101",
                "title": "Untitled - Notes",
                "app": "Notes",
                "pid": 4242,
                "x": 100,
                "y": 120,
                "width": 800,
                "height": 600,
                "focused": true,
                "elevated": null
              },
              {
                "id": "102",
                "title": "build.log - Terminal",
                "app": "Terminal",
                "pid": 5151,
                "x": 980,
                "y": 120,
                "width": 800,
                "height": 600,
                "focused": false,
                "elevated": null
              }
            ]
          },
          "variable": []
        }
      ]
    }
  ]
}
