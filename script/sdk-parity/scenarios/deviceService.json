      "row": "deviceService.enable",
      "kind": "effect",
      "input": {},
      "expect": [
        {
          "port": "deviceService",
          "op": "service.bootstrap"
        },
        {
          "port": "deviceService",
          "op": "service.setEnabled",
          "args": {
            "on": true
          }
        },
        {
          "port": "fs",
          "op": "remove",
          "args": {
            "path": "~/.omo/remote-sessions.json"
          }
        }
      ]
    },
