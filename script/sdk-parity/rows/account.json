        "account.signInCheck"
      ],
      "cells": [
        "`account.signInCheck()` answering `{ ready: true }`: a probe that the sign-in call exists; it touches nothing",
        "`omo account sign-in --check`",
        "none",
        "**no**",
        "Tool omitted: a driver's probe",
        "A1b"
      ]
    },
