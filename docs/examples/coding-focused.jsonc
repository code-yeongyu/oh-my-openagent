{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",

  // Optimized for intensive coding sessions.
  // Puts the strongest models on implementation categories and keeps research workers fast.
  // The main agent runs on your session model; these blocks tune the workers it delegates to.

  "agents": {
    // Rapid codebase navigation
    "explore": { "model": "openai/gpt-5.6-luna-fast", "reasoning": "low" },

    // Fast docs lookup
    "librarian": { "model": "openai/gpt-5.6-luna-fast", "reasoning": "low" },

    // Pre-planning consultant: minimal overhead for coding plans
    "plan-consultant": { "model": "anthropic/claude-sonnet-4-6" },

    // Plan reviewer: code quality, edge cases, and test coverage
    "plan-reviewer": {
      "model": "openai/gpt-6-astra",
      "reasoning": "high",
      "prompt": "Focus on code quality, edge cases, and test coverage.",
    },
  },

  "categories": {
    // Trivial changes: fastest possible
    "quick": { "model": "openai/gpt-5.6-luna-fast", "reasoning": "low" },

    // Standard coding tasks: good quality, fast
    "unspecified-low": { "model": "xai/grok-4.6", "reasoning": "xhigh" },

    // Complex refactors: best quality
    "unspecified-high": { "model": "openai/gpt-6-astra", "reasoning": "high" },

    // Visual work
    "visual-engineering": { "model": "anthropic/claude-fable-5-1", "reasoning": "max" },

    // Architecture consult lane: task(category: "architect")
    "architect": { "model": "anthropic/claude-fable-5-1", "reasoning": "max" },

    // Deep autonomous work
    "deep": { "model": "openai/gpt-6-astra", "reasoning": "high" },

    // Hard reasoning problems
    "ultrabrain": { "model": "openai/gpt-6-astra", "reasoning": "max" },
  },
}
