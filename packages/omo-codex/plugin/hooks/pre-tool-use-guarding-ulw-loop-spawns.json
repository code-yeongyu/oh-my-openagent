{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "^(spawn_agent|collaborationspawn_agent|collaboration\\.spawn_agent)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/ulw-loop/dist/cli.js\" hook pre-tool-use-spawn",
						"timeout": 5,
						"statusMessage": "(OmO 5.1.78) Guarding Ulw-Loop Spawns",
						"commandWindows": "cmd /d /s /c \"\"${PLUGIN_ROOT}\\components\\bootstrap\\scripts\\node-dispatch.cmd\" components\\ulw-loop\\dist\\cli.js hook pre-tool-use-spawn\""
					}
				]
			}
		]
	}
}
