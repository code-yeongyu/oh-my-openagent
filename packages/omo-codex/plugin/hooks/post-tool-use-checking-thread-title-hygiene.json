{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "^(create_thread|codex_app\\.create_thread)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/teammode/dist/cli.js\" hook post-tool-use",
						"timeout": 10,
						"statusMessage": "(OmO 5.1.78) Checking Thread Title Hygiene",
						"commandWindows": "cmd /d /s /c \"\"${PLUGIN_ROOT}\\components\\bootstrap\\scripts\\node-dispatch.cmd\" components\\teammode\\dist\\cli.js hook post-tool-use\""
					}
				]
			}
		]
	}
}
