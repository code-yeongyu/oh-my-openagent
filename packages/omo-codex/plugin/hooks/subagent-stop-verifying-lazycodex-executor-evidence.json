{
	"hooks": {
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/lazycodex-executor-verify/dist/cli.js\" hook subagent-stop",
						"timeout": 10,
						"statusMessage": "(OmO 5.1.78) Verifying LazyCodex Executor Evidence",
						"commandWindows": "cmd /d /s /c \"\"${PLUGIN_ROOT}\\components\\bootstrap\\scripts\\node-dispatch.cmd\" components\\lazycodex-executor-verify\\dist\\cli.js hook subagent-stop\""
					}
				],
				"matcher": "^lazycodex-worker-(low|medium|high)$"
			}
		]
	}
}
