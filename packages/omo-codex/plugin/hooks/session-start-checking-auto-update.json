{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/scripts/auto-update.mjs\" hook session-start",
						"timeout": 15,
						"statusMessage": "(OmO 5.1.78) Checking Auto Update",
						"commandWindows": "cmd /d /s /c \"\"${PLUGIN_ROOT}\\components\\bootstrap\\scripts\\node-dispatch.cmd\" scripts\\auto-update.mjs hook session-start\""
					}
				],
				"matcher": "^startup$"
			}
		]
	}
}
