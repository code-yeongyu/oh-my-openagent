{
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/comment-checker/dist/cli.js\" hook post-tool-use",
						"timeout": 30,
						"statusMessage": "(OmO 5.1.78) Checking Comments",
						"commandWindows": "cmd /d /s /c \"\"${PLUGIN_ROOT}\\components\\bootstrap\\scripts\\node-dispatch.cmd\" components\\comment-checker\\dist\\cli.js hook post-tool-use\""
					}
				],
				"matcher": "^(apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit)$"
			}
		]
	}
}
