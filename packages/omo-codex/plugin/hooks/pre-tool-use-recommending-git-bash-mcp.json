{
	"hooks": {
		"PreToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/components/git-bash/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "(OmO 5.1.78) Recommending Git Bash MCP",
						"commandWindows": "cmd /d /s /c \"\"${PLUGIN_ROOT}\\components\\bootstrap\\scripts\\node-dispatch.cmd\" components\\git-bash\\dist\\cli.js hook pre-tool-use\""
					}
				],
				"matcher": "^Bash$"
			}
		]
	}
}
