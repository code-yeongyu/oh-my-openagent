// knip config owned by this directory, composed by the root knip.ts (script/knip-config.ts).
{
  "workspaces": {
    "packages/omo-codex/plugin/components/comment-checker": {
      "includeEntryExports": true,
      // Vitest is installed by this package's own npm ci, which the root install does not run, so knip cannot load vitest.config.ts; these are its config and test globs.
      "vitest": {"config":[],"entry":["vitest.config.ts","test/**/*.test.ts"]},
      // knip's default entry patterns (an explicit "entry" replaces them), files run by path from package.json scripts or CI
      // workflows, and the test, config and helper files plugins report with exports unchecked: listing them export-checks
      // them too (script/knip-entry-exports.test.ts probes every knip entry and fails on one that is missing).
      "entry": [
        "{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.{test,spec}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.test-d.ts",
        "test/fixtures/apply-patch-mixed-requests.ts",
        "vitest.config.ts",
      ],
      "ignoreFiles": [
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "src/core-values.ts",
      ],
      "ignoreDependencies": [
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "@biomejs/biome",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "@vitest/coverage-v8",
      ],
      // pre-existing at origin dev 4686e425b5: executables this package runs that it does not declare
      "ignoreBinaries": ["biome", "vitest"],
    }
  },
  "preExistingExports": {
    // pre-existing at origin dev 4686e425b5: unused export(s) parseCodexPostToolUseInput
    "packages/omo-codex/plugin/components/comment-checker/src/codex-hook.ts": ["parseCodexPostToolUseInput"],
    // pre-existing at origin dev 4686e425b5: unused export(s) parseApplyPatchRequests, isToolFailureOutput
    "packages/omo-codex/plugin/components/comment-checker/src/core.ts": ["parseApplyPatchRequests", "isToolFailureOutput"],
    // pre-existing at origin dev 4686e425b5: unused export(s) isToolFailureOutput
    "packages/omo-codex/plugin/components/comment-checker/src/request-extractor.ts": ["isToolFailureOutput"],
    // pre-existing at origin dev 4686e425b5: unused export(s) default
    "packages/omo-codex/plugin/components/comment-checker/vitest.config.ts": ["default"]
  }
}
