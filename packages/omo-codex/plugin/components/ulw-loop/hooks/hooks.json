{
	"hooks": {
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook user-prompt-submit --with-ultrawork",
						"timeout": 10,
						"statusMessage": "(OmO 5.0.0-beta.30) Checking Ulw-Loop Steering"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^create_goal$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook pre-tool-use",
						"timeout": 5,
						"statusMessage": "(OmO 5.0.0-beta.30) Enforcing Unlimited Ulw-Loop Budget"
					}
				]
			},
			{
				"matcher": "^(spawn_agent|collaborationspawn_agent|collaboration\\.spawn_agent)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook pre-tool-use-spawn",
						"timeout": 5,
						"statusMessage": "(OmO 5.0.0-beta.30) Guarding Ulw-Loop Spawns"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(spawn_agent|collaborationspawn_agent|collaboration\\.spawn_agent)$",
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook post-tool-use-spawn",
						"timeout": 5,
						"statusMessage": "(OmO 5.0.0-beta.21) Recording Swarm Spawn Outcomes"
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook post-compact-spawn-ledger",
						"timeout": 5,
						"statusMessage": "(OmO 5.0.0-beta.21) Rehydrating Swarm Ledger"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"${PLUGIN_ROOT}/dist/cli.js\" hook stop",
						"timeout": 10,
						"statusMessage": "(OmO 5.0.0-beta.30) Checking Ulw-Loop Resume"
					}
				]
			}
		]
	}
}
