// knip config owned by this directory, composed by the root knip.ts (script/knip-config.ts).
{
  "workspaces": {
    "packages/omo-codex/plugin/components/telemetry": {
      "includeEntryExports": true,
      // Vitest is installed by this package's own npm ci, which the root install does not run, so knip cannot load vitest.config.ts; these are its config and test globs.
      "vitest": {"config":[],"entry":["vitest.config.ts","**/*.test.ts"]},
      // knip's default entry patterns (an explicit "entry" replaces them), files run by path from package.json scripts or CI
      // workflows, and the test, config and helper files plugins report with exports unchecked: listing them export-checks
      // them too (script/knip-entry-exports.test.ts probes every knip entry and fails on one that is missing).
      "entry": [
        "{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/posthog.ts",
        "**/*.{test,spec}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.test-d.ts",
        "vitest.config.ts",
      ],
      "ignoreDependencies": [
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "@biomejs/biome",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "@vitest/coverage-v8",
      ],
      // pre-existing at origin dev 4686e425b5: executables this package runs that it does not declare
      "ignoreBinaries": ["biome", "vitest"],
    }
  },
  "preExistingExports": {
    // pre-existing at origin dev 4686e425b5: unused export(s) DEFAULT_POSTHOG_API_KEY, DEFAULT_POSTHOG_HOST, getComponentVersion
    // #11572 (origin dev 4c87d16a73) removed the exports __createPluginPostHogForTesting and getPostHogDistinctIdForTesting; their rows are gone with them.
    "packages/omo-codex/plugin/components/telemetry/src/posthog.ts": ["DEFAULT_POSTHOG_API_KEY", "DEFAULT_POSTHOG_HOST", "getComponentVersion"],
    // pre-existing at origin dev 4686e425b5: unused export(s) DEFAULT_POSTHOG_API_KEY, DEFAULT_POSTHOG_HOST, PRODUCT_NAME, PACKAGE_NAME, EVENT_NAME, LEGACY_PARENT_PACKAGE, PRODUCT_ENV_PREFIX
    "packages/omo-codex/plugin/components/telemetry/src/product-identity.ts": ["DEFAULT_POSTHOG_API_KEY", "DEFAULT_POSTHOG_HOST", "PRODUCT_NAME", "PACKAGE_NAME", "EVENT_NAME", "LEGACY_PARENT_PACKAGE", "PRODUCT_ENV_PREFIX"],
    // pre-existing at origin dev 4686e425b5: unused export(s) default
    "packages/omo-codex/plugin/components/telemetry/vitest.config.ts": ["default"]
  }
}
