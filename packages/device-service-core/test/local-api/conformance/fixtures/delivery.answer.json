            "sender_device": "dev-peer-1",
            "command_id": "Q01EV0FLRTAwMDAwMDAwMQ",
            "reply": {
              "type": "response"
            }
          }
        },
        {
          "expect": {
            "id": "2",
            "type": "response",
            "ok": false,
            "error": {
              "code": "unknown_delivery"
            }
          }
        }
      ]
    },
