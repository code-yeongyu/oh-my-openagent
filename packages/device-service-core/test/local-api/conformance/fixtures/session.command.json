{
  "request": "session.command",
  "cases": [
    {
      "name": "a prompt answers its command_id, then queued, transport_confirmed, engine_applied",
      "outcome": "ok",
      "steps": [
        {
          "send": {
            "id": "att",
            "type": "session.attach",
            "device": "dev-peer-1",
            "session_id": "c2Vzc2lvbi1rZXktMDAwMQ"
          }
        },
        {
          "expect": {
            "id": "att",
            "type": "response",
            "ok": true,
            "data": {
              "attach": "<capture:a>"
            }
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.snapshot",
            "attach": "<ref:a>",
            "attach_id": 1
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.records",
            "attach": "<ref:a>",
            "attach_id": 1
          }
        },
        {
          "send": {
            "id": "2",
            "type": "session.command",
            "attach": "<ref:a>",
            "command_id": "Y29tbWFuZC1pZC0wMDAwMQ",
            "command": {
              "op": "prompt",
              "text": "hello"
            }
          }
        },
        {
          "expect": {
            "id": "2",
            "type": "response",
            "ok": true,
            "data": {
              "command_id": "Y29tbWFuZC1pZC0wMDAwMQ"
            }
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.command_state",
            "command_id": "Y29tbWFuZC1pZC0wMDAwMQ",
            "state": "queued",
            "retryable": false
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.command_state",
            "command_id": "Y29tbWFuZC1pZC0wMDAwMQ",
            "state": "transport_confirmed",
            "retryable": false
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.command_state",
            "command_id": "Y29tbWFuZC1pZC0wMDAwMQ",
            "state": "engine_applied",
            "retryable": false
          }
        }
      ]
    },
