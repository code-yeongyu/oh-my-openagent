      "name": "control.attach.get answers the attach state",
      "outcome": "ok",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.attach.get"
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": true,
            "data": {
              "attached": true,
              "changedAt": ""
            }
          }
        }
      ]
    },
    {
      "name": "control.attach.get with a stray field is refused",
      "outcome": "refusal",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.attach.get",
            "attached": true
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": false,
            "error": {
              "code": "invalid_request"
            }
          }
        }
      ]
    },
    {
      "name": "refused before the client proof",
      "outcome": "refusal",
      "handshake": "welcome_only",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.attach.get"
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": false,
            "error": {
              "code": "unauthenticated"
            }
          }
        }
      ]
    }
  ]
