              "merge_device_ids": []
            }
          }
        }
      ]
    },
    {
      "name": "refuses a padded salt",
      "outcome": "refusal",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "device.machine_binding",
            "machine_salt": "BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc="
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": false,
            "error": {
