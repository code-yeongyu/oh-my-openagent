{
  "request": "control.session_wake.set",
  "cases": [
    {
      "name": "control.session_wake.set stores on",
      "outcome": "ok",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.session_wake.set",
            "enabled": true
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": true,
            "data": {
              "enabled": true,
              "stored": true,
              "overridden": false
            }
          }
        }
      ]
    },
    {
      "name": "control.session_wake.set null removes the stored value",
      "outcome": "ok",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.session_wake.set",
            "enabled": null
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": true,
            "data": {
              "enabled": false,
              "stored": null
            }
          }
        }
      ]
    },
    {
      "name": "control.session_wake.set with a value that is not true, false or null is refused",
      "outcome": "refusal",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.session_wake.set",
            "enabled": "yes"
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": false,
            "error": {
              "code": "invalid_request"
            }
          }
        }
      ]
    },
    {
      "name": "control.session_wake.set with a stray field is refused",
      "outcome": "refusal",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.session_wake.set",
            "enabled": true,
            "scope": "all"
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": false,
            "error": {
              "code": "invalid_request"
            }
          }
        }
      ]
    },
    {
      "name": "refused before the client proof",
      "outcome": "refusal",
      "handshake": "welcome_only",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "control.session_wake.set",
            "enabled": true
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": false,
            "error": {
              "code": "unauthenticated"
            }
          }
        }
      ]
    }
  ]
}
