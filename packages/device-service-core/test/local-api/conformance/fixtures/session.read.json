{
  "request": "session.read",
  "cases": [
    {
      "name": "a page answers entries and an entry over the size limit as too_large",
      "outcome": "ok",
      "steps": [
        {
          "send": {
            "id": "att",
            "type": "session.attach",
            "device": "dev-peer-1",
            "session_id": "c2Vzc2lvbi1rZXktMDAwMQ"
          }
        },
        {
          "expect": {
            "id": "att",
            "type": "response",
            "ok": true,
            "data": {
              "attach": "<capture:a>"
            }
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.snapshot",
            "attach": "<ref:a>",
            "attach_id": 1
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.records",
            "attach": "<ref:a>",
            "attach_id": 1
          }
        },
        {
          "send": {
            "id": "2",
            "type": "session.read",
            "attach": "<ref:a>",
            "before_entry_id": "e-3"
          }
        },
        {
          "expect": {
            "id": "2",
            "type": "response",
            "ok": true,
            "data": {
              "query_id": "<capture:q>"
            }
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.read_result",
            "attach": "<ref:a>",
            "query_id": "<ref:q>",
            "next_before": null,
            "entries": [
              {
                "kind": "entry",
                "entry_id": "e-1"
              },
              {
                "kind": "entry_ref",
                "entry_id": "e-2",
                "bytes": 20000000
              }
            ]
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.blob_abort",
            "attach": "<ref:a>",
            "reason": "too_large",
            "query_id": "<ref:q>",
            "entry_id": "e-2"
          }
        }
      ]
    },
    {
      "name": "a tail over 200 is refused",
      "outcome": "refusal",
      "steps": [
        {
          "send": {
            "id": "att",
            "type": "session.attach",
            "device": "dev-peer-1",
            "session_id": "c2Vzc2lvbi1rZXktMDAwMQ"
          }
        },
        {
          "expect": {
            "id": "att",
            "type": "response",
            "ok": true,
            "data": {
              "attach": "<capture:a>"
            }
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.snapshot",
            "attach": "<ref:a>",
            "attach_id": 1
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "session.records",
            "attach": "<ref:a>",
            "attach_id": 1
          }
        },
        {
          "send": {
            "id": "2",
            "type": "session.read",
            "attach": "<ref:a>",
            "tail": 201
          }
        },
        {
          "expect": {
            "id": "2",
            "type": "response",
            "ok": false,
            "error": {
              "code": "invalid_request"
            }
          }
        }
      ]
    },
    {
      "name": "an unknown attach is refused not_attached",
      "outcome": "refusal",
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "session.read",
            "attach": "bm8tc3VjaC1hdHRhY2g"
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": false,
            "error": {
              "code": "not_attached"
            }
          }
        }
      ]
    }
  ]
}
