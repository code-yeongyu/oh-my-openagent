{
  "request": "delivery.held",
  "cases": [
    {
      "name": "a consumer answers whether it holds a durable id",
      "outcome": "ok",
      "world": {
        "deliveries": {
          "agent_dirs": ["/agents/a"],
          "asked": ["0193f5c2-7e1a-7c3e-9b1a-2f6c8d4e5a10"]
        }
      },
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "deliveries.serve",
            "agent_dir": "/agents/a",
            "v": 1
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": true,
            "data": {
              "wake": false
            }
          }
        },
        {
          "expect": {
            "type": "event",
            "kind": "delivery.holds",
            "ask_id": "<capture:ask>",
            "durable_id": "0193f5c2-7e1a-7c3e-9b1a-2f6c8d4e5a10"
          }
        },
        {
          "send": {
            "id": "2",
            "type": "delivery.held",
            "ask_id": "<ref:ask>",
            "holds": true
          }
        },
        {
          "expect": {
            "id": "2",
            "type": "response",
            "ok": true,
            "data": {}
          }
        }
      ]
    },
    {
      "name": "an answer to no open question is invalid",
      "outcome": "refusal",
      "world": {
        "deliveries": {
          "agent_dirs": ["/agents/a"]
        }
      },
      "steps": [
        {
          "send": {
            "id": "1",
            "type": "deliveries.serve",
            "agent_dir": "/agents/a",
            "v": 1
          }
        },
        {
          "expect": {
            "id": "1",
            "type": "response",
            "ok": true,
            "data": {
              "wake": false
            }
          }
        },
        {
          "send": {
            "id": "2",
            "type": "delivery.held",
            "ask_id": "a-unknown",
            "holds": false
          }
        },
        {
          "expect": {
            "id": "2",
            "type": "response",
            "ok": false,
            "error": {
              "code": "invalid_request"
            }
          }
        }
      ]
    }
  ]
}
