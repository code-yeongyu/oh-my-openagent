{
  "name": "oh-my-openagent-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node ./scripts/generate-docs-content.mjs",
    "prebuild": "node ./scripts/prepare-build.mjs",
    "dev": "next dev",
    "build": "bun --bun next build",
    "start": "next start",
    "poster:graph": "bun scripts/render-graph-poster.mjs",
    "check:graph-budget": "bun scripts/check-graph-budget.mjs",
    "icons:render": "bun scripts/render-app-icons.mjs",
    "icons:check": "bun scripts/render-app-icons.mjs --check",
    "lint": "biome lint app components lib e2e scripts && eslint --cache --cache-location .next/cache/eslint/.eslintcache \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx,mjs}\" \"e2e/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "lint:fix": "biome lint --write app components lib e2e scripts && eslint --cache --cache-location .next/cache/eslint/.eslintcache --fix \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx,mjs}\" \"e2e/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "type-check": "node ./scripts/generate-docs-content.mjs && tsgo --noEmit",
    "test": "bun test lib",
    "test:e2e": "bun --bun playwright test",
    "test:e2e:ui": "bun --bun playwright test --ui",
    "test:e2e:headed": "bun --bun playwright test --headed",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lucide-react": "1.47.0",
    "marked": "^18.0.13",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.186.0"
  },
  "browserslist": [
    "chrome >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "edge >= 111"
  ],
  "overrides": {
    "@humanfs/node": "0.16.8",
    "body-parser": "2.3.0",
    "brace-expansion": "5.0.12",
    "fast-xml-parser": "5.7.3",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "minimatch": "10.2.4",
    "nanoid": "3.3.18",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@eslint/compat": "2.1.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@typescript/native-preview": "7.0.0-dev.20260518.1",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "wrangler": "^4.135.0"
  }
}
