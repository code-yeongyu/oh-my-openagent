// knip config owned by this directory, composed by the root knip.ts (script/knip-config.ts).
{
  "workspaces": {
    "packages/web": {
      "includeEntryExports": true,
      // Playwright is installed by this package's own install, which the root install does not run, so knip cannot load the
      // playwright configs (its scripts pass them with --config); the configs and the ./e2e specs are listed as entries instead.
      "playwright": false,
      // knip's default entry patterns (an explicit "entry" replaces them), files run by path from package.json scripts or CI
      // workflows, and the test, config and helper files plugins report with exports unchecked: listing them export-checks
      // them too (script/knip-entry-exports.test.ts probes every knip entry and fails on one that is missing).
      "entry": [
        "{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "playwright*.config.ts",
        "e2e/**/*.spec.ts",
        "scripts/generate-docs-content.mjs",
        "scripts/prepare-build.mjs",
        "scripts/retain-static-assets.mjs",
        "**/*.{test,spec}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.test-d.ts",
        // Every Next.js special file at any depth: these are the knip 6.43.0 Next.js plugin's own entry patterns
        // (dist/plugins/next/index.js getEntryFilePatterns, this app has no src/ dir and the default pageExtensions), which it
        // adds with exports unchecked, so they are listed here to be export-checked. Their route-segment config exports
        // (revalidate, metadata, generateMetadata, ...) are dropped by name by script/knip-next-route-segment-exports.ts;
        // the remaining framework-consumed ones (default, GET, ...) are named per symbol in preExistingExports.
        "app/{,[(]*[)]/}{manifest,robots}.{js,ts}",
        "app/**/sitemap.{js,ts}",
        "app/**/{icon,apple-icon,opengraph-image,twitter-image}.{js,jsx,ts,tsx}",
        "{,src/}{instrumentation,instrumentation-client,middleware,proxy}.{js,jsx,ts,tsx}",
        "app/global-{error,not-found}.{js,jsx,ts,tsx}",
        "app/**/{default,error,forbidden,loading,not-found,unauthorized}.{js,jsx,ts,tsx}",
        "app/**/{layout,page,route,template}.{js,jsx,ts,tsx}",
        "pages/**/*.{js,jsx,ts,tsx}",
        "eslint.config.mjs",
        "i18n/request.ts",
        "next.config.ts",
        "postcss.config.mjs",
        "scripts/check-graph-budget.mjs",
        "scripts/render-app-icons.mjs",
        "scripts/render-graph-poster.mjs",
      ],
      "ignoreFiles": [
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "components/landing/agents-data.ts",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "components/ui/card.tsx",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "components/ui/section.tsx",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "components/ui/separator.tsx",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "e2e/support/download-fixture-server.ts",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "lib/og/graph-glyph.tsx",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "lib/og/omo-logo.ts",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "lib/og/tagline.tsx",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "open-next.config.ts",
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "scripts/generate-og-fonts.mjs",
      ],
      "ignoreDependencies": [
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "@biomejs/biome",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "@opennextjs/cloudflare",
        // pre-existing at origin dev 4686e425b5: a declared dependency nothing imports
        "@radix-ui/react-separator",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "@types/react-dom",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "eslint",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "eslint-plugin-prettier",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "globals",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "prettier",
        // pre-existing at origin dev 4686e425b5: a declared dependency nothing imports
        "react-dom",
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "wrangler",
      ],
      // pre-existing at origin dev 4686e425b5: executables this package runs that it does not declare
      "ignoreBinaries": ["eslint", "next", "opennextjs-cloudflare", "prettier", "wrangler"],
      "ignoreIssues": {
        // pre-existing at origin dev 4686e425b5: duplicate export(s) GraphHero, default
