        "lib/docs-page.test.ts": ["unresolved"],
        // pre-existing at origin dev 4686e425b5: imports that do not resolve ./docs-content.generated
        "lib/docs-source.ts": ["unresolved"],
        // pre-existing at origin dev 4686e425b5: imports of undeclared packages postcss-load-config
        "postcss.config.mjs": ["unlisted"],
      },
    }
  },
