# Generated artifacts — regenerated by `bun run build:omp-plugin` (freshness-checked by tests).
# Mirrors packages/omo-senpi/.gitignore: extension bundles and synced skills are build outputs;
# the lsp-daemon runtime is staged by build:omp-plugin (the senpi convention keeps the staged
# agent-toolkit + ast-grep runtimes untracked too — the ast-grep one is a built binary).
/plugin/extensions/
/plugin/skills/
/plugin/runtime/ast-grep-mcp/
/plugin/runtime/agent-toolkit/
/plugin/runtime/lsp-daemon/
plugin/extensions/*.meta.json
.build-extension-test-*/
