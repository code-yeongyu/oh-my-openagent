    "packages/lsp-daemon/src/index.ts": ["disposeDefaultLspManager", "callDiagnosticsViaDaemon", "callToolViaDaemon", "currentRequestContext", "ensureDaemonRunning", "InvalidRuntimeOverrideError", "OMO_LSP_DAEMON_CLI", "probeDaemon", "resolveDaemonRuntime", "daemonPaths", "InvalidDaemonDirectoryError", "InvalidDaemonVersionError", "OMO_LSP_DAEMON_DIR", "OMO_LSP_DAEMON_VERSION", "validateDaemonVersion", "runMcpStdioProxy"],
