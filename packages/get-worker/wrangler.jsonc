{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omo-get",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "get.omo.dev", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.sh", "**/*.ps1"], "fallthrough": false }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "omo-releases" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omo-get",
      "database_id": "b092623f-af18-4267-b34f-527005a7949b",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "omo_downloads" }],
  // ANALYTICS_TOKEN (secret) is a read-only Account Analytics token used only by the hourly rollup.
  "vars": { "ACCOUNT_ID": "c3552546c02ce87ca7c9416aeb53463e", "ANALYTICS_DATASET": "omo_downloads" },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
