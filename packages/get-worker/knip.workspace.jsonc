// knip config owned by this directory, composed by the root knip.ts (script/knip-config.ts).
{
  "workspaces": {
    "packages/get-worker": {
      "includeEntryExports": true,
      // knip's default entry patterns (an explicit "entry" replaces them), files run by path from package.json scripts or CI
      // workflows, and the test, config and helper files plugins report with exports unchecked: listing them export-checks
      // them too (script/knip-entry-exports.test.ts probes every knip entry and fails on one that is missing).
      "entry": [
        "{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.{test,spec}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.test-d.ts",
        "src/index.ts",
        "test/fakes.ts",
      ],
      "ignoreDependencies": [
        // pre-existing at origin dev 4686e425b5: a declared devDependency nothing imports
        "wrangler",
      ],
      // pre-existing at origin dev 4686e425b5: executables this package runs that it does not declare
      "ignoreBinaries": ["shellcheck", "wrangler"],
    }
  },
  "preExistingExports": {
    // pre-existing at origin dev 4686e425b5: unused export(s) queryAnalytics, storeRollup
    "packages/get-worker/src/downloads-rollup.ts": ["queryAnalytics", "storeRollup"],
    // pre-existing at origin dev 4686e425b5: unused export(s) default
    "packages/get-worker/src/index.ts": ["default"],
    // pre-existing at origin dev 4686e425b5: unused export(s) GITHUB_REPOSITORY, CHANNELS, isBetaVersion
    "packages/get-worker/src/release-names.ts": ["GITHUB_REPOSITORY", "CHANNELS", "isBetaVersion"],
    // pre-existing at origin dev 4686e425b5: unused export(s) IMMUTABLE
    "packages/get-worker/src/serve-release.ts": ["IMMUTABLE"],
    // pre-existing at origin dev 4686e425b5: unused export(s) FakeBucket, FakeCache
    "packages/get-worker/test/fakes.ts": ["FakeBucket", "FakeCache"]
  }
}
