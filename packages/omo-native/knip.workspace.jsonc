// knip config owned by this directory, composed by the root knip.ts (script/knip-config.ts).
{
  "workspaces": {
    "packages/omo-native": {
      "includeEntryExports": true,
      // knip's default entry patterns (an explicit "entry" replaces them), files run by path from package.json scripts or CI
      // workflows, and the test, config and helper files plugins report with exports unchecked: listing them export-checks
      // them too (script/knip-entry-exports.test.ts probes every knip entry and fails on one that is missing).
      "entry": [
        "{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "bin/senpi-patch.mjs",
        // the engine entry the npm launcher spawns by path for a launch that claims memory sync at boot (launcher.js)
        "bin/lib/engine-boot.js",
        // the manual GUI-session QA runner for the keychain helper: a person runs it by path in a dedicated QA login session
        "keychain-helper/gui-session-runner.ts",
        "keychain-helper/build.ts",
        "**/*.{test,spec}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.test-d.ts",
        "test/account-linux-no-gdbus.fixture.ts",
        "test/bun-bin-shim.fixture.ts",
        "test/bun-bin-shim.test-support.ts",
        "test/daemon-test-support.ts",
        "test/keychain-helper.test-support.ts",
        "test/fixtures/compiled-setup/entry.ts",
        "test/fixtures/provisioned-handoff/entry.ts",
        "test/fixtures/senpi-hooks-state-child.mjs",
        "test/fixtures/senpi-hooks-state-consumer.mjs",
        "test/fixtures/trust-ensure-probe.ts",
        "test/fixtures/trust-stage-probe.ts",
        "test/packed-consumer.mjs",
        "test/teardown.test-support.ts",
        "test/trust-certificate-fixtures.ts",
      ],
      "ignoreFiles": [
        // pre-existing at origin dev 4686e425b5: a file nothing imports or runs
        "launcher-commands.ts",
      ],
      // pre-existing at origin dev 4686e425b5: executables this package runs that it does not declare
      "ignoreBinaries": ["gdbus", "mkfifo"],
    }
  },
