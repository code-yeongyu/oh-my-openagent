{
  "name": "omo-ai",
  "version": "5.1.84",
  "type": "module",
  "description": "OmO Native - the standalone omo command with the OMO extension built in: bun add -g omo-ai",
  "bin": {
    "omo": "bin/omo.js"
  },
  "exports": {
    "./remote": {
      "types": "./bin/lib/remote-sdk.generated.d.ts",
      "default": "./bin/lib/remote-sdk.generated.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "plugin"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node bin/senpi-patch.mjs"
  },
  "dependencies": {
    "@code-yeongyu/senpi": "2026.11.23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-yeongyu/oh-my-openagent.git"
  }
}
