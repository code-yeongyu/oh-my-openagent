// knip config owned by this directory, composed by the root knip.ts (script/knip-config.ts).
{
  "workspaces": {
    "packages/mcp-client-core": {
      "includeEntryExports": true,
      // knip's default entry patterns (an explicit "entry" replaces them), files run by path from package.json scripts or CI
      // workflows, and the test, config and helper files plugins report with exports unchecked: listing them export-checks
      // them too (script/knip-entry-exports.test.ts probes every knip entry and fails on one that is missing).
      "entry": [
        "{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.{test,spec}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.test-d.ts",
        "src/skill-mcp-manager/env-grants-store.ts",
      ],
    }
  },
  "preExistingExports": {
    // pre-existing at origin dev 4686e425b5: unused export(s) buildAuthorizationUrl, generateCodeChallenge, generateCodeVerifier, runAuthorizationCodeRedirect
    "packages/mcp-client-core/src/mcp-oauth/index.ts": ["buildAuthorizationUrl", "generateCodeChallenge", "generateCodeVerifier", "runAuthorizationCodeRedirect"],
    // pre-existing at origin dev 4686e425b5: unused export(s) generateCodeVerifier, generateCodeChallenge, buildAuthorizationUrl
    "packages/mcp-client-core/src/mcp-oauth/provider.ts": ["generateCodeVerifier", "generateCodeChallenge", "buildAuthorizationUrl"],
