    "packages/mcp-client-core/src/mcp-oauth/refresh-mutex.ts": ["isRefreshInProgress", "getActiveRefreshCount"],
    // pre-existing at origin dev 4686e425b5: unused export(s) writeTokenIndex
    "packages/mcp-client-core/src/mcp-oauth/storage-index.ts": ["writeTokenIndex"],
    // pre-existing at origin dev 4686e425b5: unused export(s) getMcpOauthStorageDir, getMcpOauthServerHash
    "packages/mcp-client-core/src/mcp-oauth/storage.ts": ["getMcpOauthStorageDir", "getMcpOauthServerHash"],
    // pre-existing at origin dev 4686e425b5: unused export(s) stopCleanupTimer
    "packages/mcp-client-core/src/skill-mcp-manager/cleanup.ts": ["stopCleanupTimer"],
