        "**/*.test-d.ts",
        "scripts/qa/fused-equivalence-e2e.mjs",
        // run by path as the bunshin-ts eval SDK's live QA driver (scripts/qa/AGENTS.md)
        "scripts/qa/bunshin-ts-eval-sdk-qa.mjs",
