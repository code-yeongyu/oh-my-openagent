{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ESNext"],
    "types": ["bun-types", "node"],
    "typeRoots": ["./node_modules/@types", "./node_modules"]
  },
  "include": ["src/**/*"]
}
