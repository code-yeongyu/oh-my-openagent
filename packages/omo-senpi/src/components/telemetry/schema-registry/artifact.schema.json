{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omo.dev/schemas/telemetry-artifact.schema.json",
  "title": "OmO telemetry product schema artifact",
  "description": "The per-product allowlist the collector pins (plan D-A, D-I, D-P). Every wire key matches keyPattern and none is forbidden; every string has values or a pattern from the fixed safePattern set; every number has min and max.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_format",
    "product",
    "schema_version",
    "proto_tag",
    "identity",
    "relay",
    "semconv_map_sha256",
    "resource",
    "scope",
    "events",
    "spans",
    "values",
    "sha256"
  ],
  "properties": {
    "artifact_format": {
      "const": 1
    },
    "product": {
      "type": "string",
      "enum": ["omo-senpi", "omo-cloud", "omo-desktop", "omo-service"]
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "proto_tag": {
      "type": "string",
      "pattern": "^v1\\.(?:[7-9]|[1-9][0-9])\\.[0-9]+$"
    },
    "identity": {
      "enum": ["install", "none"]
    },
    "relay": {
      "type": "boolean"
    },
    "semconv_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "resource": {
      "type": "object",
      "$ref": "#/$defs/attributeMap",
      "required": [
        "service.name",
        "service.version",
        "service.instance.id",
        "os.type",
        "host.arch",
        "telemetry.sdk.name",
        "telemetry.sdk.language",
        "telemetry.sdk.version",
        "omo.schema.version",
        "omo.surface",
        "omo.ci"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["omo-senpi", "omo-desktop", "omo-service", "omo-cloud"]
          }
        },
        "version": {
          "$ref": "#/$defs/safePattern"
        }
      }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "type": "object",
        "$ref": "#/$defs/attributeMap",
        "required": ["log.record.uid"]
      }
    },
    "spans": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/attributeMap"
      }
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/wireKey"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["rows"],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "source_key": {
            "$ref": "#/$defs/wireKey"
          },
          "note": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "wire"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "wire": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              }
            }
          }
        }
      }
    },
    "resource_projections": {
      "description": "Per event: PostHog properties today's client sends on the event that the wire carries in the Resource (the relay copies them back).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "$ref": "#/$defs/projectionName"
        },
        "additionalProperties": {
          "$ref": "#/$defs/wireKey"
        }
      }
    },
    "derived_properties": {
      "description": "Per event: PostHog properties the relay derives from a wire attribute instead of reading one (cost_usd = omo.cost.usd_1e4 / 1e4).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "$ref": "#/$defs/derivedName"
        },
        "additionalProperties": {
          "type": "object",
          "required": ["from", "divide_by"],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/wireKey"
            },
            "divide_by": {
              "type": "number"
            }
          }
        }
      }
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "keyPattern": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,5}$"
    },
    "forbiddenKeys": {
      "description": "Exact forbidden field names, compared after normalization (leading $ _ @ stripped, lower-cased, . _ - unified): wire forms, PostHog forms and PostHog identity/group-merge names.",
      "enum": [
        "omo.install_id",
        "install_id",
        "exception.message",
        "exception.stacktrace",
        "exception.type",
        "code.file.path",
        "code.filepath",
        "code.function.name",
        "code.stacktrace",
        "url.full",
        "url.path",
        "url.query",
        "client.address",
        "server.address",
        "network.peer.address",
        "gen_ai.input.messages",
        "gen_ai.output.messages",
        "gen_ai.prompt",
        "gen_ai.completion",
        "gen_ai.system_instructions",
        "gen_ai.tool.call.arguments",
        "gen_ai.tool.call.result",
        "host.name",
        "host_name",
        "hostname",
        "ip",
        "email",
        "message",
        "stack",
        "reason",
        "path",
        "distinct_id",
        "$ip",
        "$current_url",
        "$pathname",
        "$host",
        "$referrer",
        "$referring_domain",
        "$raw_user_agent",
        "$user_agent",
        "$device_name",
        "$set",
        "$set_once",
        "$unset",
        "$exception",
        "$anon_distinct_id",
        "$groups"
      ]
    },
    "forbiddenWords": {
      "description": "Identity words banned as a token anywhere in a normalized name (email_address, user_email_hash, ip_address).",
      "enum": ["email", "ip", "hostname", "host_name", "distinct_id"]
    },
    "forbiddenSuffixes": {
      "description": "Content words banned as the last token(s) of a normalized name: text that can be free-form (a count, code or fingerprint of it is a bounded value and stays legal).",
      "enum": ["reason", "stack", "message", "path", "text", "prompt", "stack_trace"]
    },
    "forbiddenEndings": {
      "description": "Endings banned even inside a token (omo.errorstacktrace).",
      "enum": ["stacktrace"]
    },
    "forbiddenPrefixes": {
      "description": "Namespaces banned as the leading token(s) of a normalized name: end-user identity, collector internals, PostHog exception, geoip, initial-attribution and group properties.",
      "enum": ["user", "enduser", "omo.collector", "exception", "geoip", "initial", "group"]
    },
    "fieldName": {
      "description": "The forbidden-key rule (plan D-I), the one definition every field-name position uses. Each pattern is generated from the forbidden* lists above (src/field-name-rule.ts) and matches every variant of a listed name: any leading $ _ @, any letter case, and . _ - as one separator.",
      "type": "string",
      "maxLength": 64,
      "allOf": [
        {
          "not": {
            "pattern": "^[$_@.-]*(?:[oO][mM][oO][._-]+[iI][nN][sS][tT][aA][lL][lL][._-]+[iI][dD]|[iI][nN][sS][tT][aA][lL][lL][._-]+[iI][dD]|[eE][xX][cC][eE][pP][tT][iI][oO][nN][._-]+[mM][eE][sS][sS][aA][gG][eE]|[eE][xX][cC][eE][pP][tT][iI][oO][nN][._-]+[sS][tT][aA][cC][kK][tT][rR][aA][cC][eE]|[eE][xX][cC][eE][pP][tT][iI][oO][nN][._-]+[tT][yY][pP][eE]|[cC][oO][dD][eE][._-]+[fF][iI][lL][eE][._-]+[pP][aA][tT][hH]|[cC][oO][dD][eE][._-]+[fF][iI][lL][eE][pP][aA][tT][hH]|[cC][oO][dD][eE][._-]+[fF][uU][nN][cC][tT][iI][oO][nN][._-]+[nN][aA][mM][eE]|[cC][oO][dD][eE][._-]+[sS][tT][aA][cC][kK][tT][rR][aA][cC][eE]|[uU][rR][lL][._-]+[fF][uU][lL][lL]|[uU][rR][lL][._-]+[pP][aA][tT][hH]|[uU][rR][lL][._-]+[qQ][uU][eE][rR][yY]|[cC][lL][iI][eE][nN][tT][._-]+[aA][dD][dD][rR][eE][sS][sS]|[sS][eE][rR][vV][eE][rR][._-]+[aA][dD][dD][rR][eE][sS][sS]|[nN][eE][tT][wW][oO][rR][kK][._-]+[pP][eE][eE][rR][._-]+[aA][dD][dD][rR][eE][sS][sS]|[gG][eE][nN][._-]+[aA][iI][._-]+[iI][nN][pP][uU][tT][._-]+[mM][eE][sS][sS][aA][gG][eE][sS]|[gG][eE][nN][._-]+[aA][iI][._-]+[oO][uU][tT][pP][uU][tT][._-]+[mM][eE][sS][sS][aA][gG][eE][sS]|[gG][eE][nN][._-]+[aA][iI][._-]+[pP][rR][oO][mM][pP][tT]|[gG][eE][nN][._-]+[aA][iI][._-]+[cC][oO][mM][pP][lL][eE][tT][iI][oO][nN]|[gG][eE][nN][._-]+[aA][iI][._-]+[sS][yY][sS][tT][eE][mM][._-]+[iI][nN][sS][tT][rR][uU][cC][tT][iI][oO][nN][sS]|[gG][eE][nN][._-]+[aA][iI][._-]+[tT][oO][oO][lL][._-]+[cC][aA][lL][lL][._-]+[aA][rR][gG][uU][mM][eE][nN][tT][sS]|[gG][eE][nN][._-]+[aA][iI][._-]+[tT][oO][oO][lL][._-]+[cC][aA][lL][lL][._-]+[rR][eE][sS][uU][lL][tT]|[hH][oO][sS][tT][._-]+[nN][aA][mM][eE]|[hH][oO][sS][tT][._-]+[nN][aA][mM][eE]|[hH][oO][sS][tT][nN][aA][mM][eE]|[iI][pP]|[eE][mM][aA][iI][lL]|[mM][eE][sS][sS][aA][gG][eE]|[sS][tT][aA][cC][kK]|[rR][eE][aA][sS][oO][nN]|[pP][aA][tT][hH]|[dD][iI][sS][tT][iI][nN][cC][tT][._-]+[iI][dD]|[iI][pP]|[cC][uU][rR][rR][eE][nN][tT][._-]+[uU][rR][lL]|[pP][aA][tT][hH][nN][aA][mM][eE]|[hH][oO][sS][tT]|[rR][eE][fF][eE][rR][rR][eE][rR]|[rR][eE][fF][eE][rR][rR][iI][nN][gG][._-]+[dD][oO][mM][aA][iI][nN]|[rR][aA][wW][._-]+[uU][sS][eE][rR][._-]+[aA][gG][eE][nN][tT]|[uU][sS][eE][rR][._-]+[aA][gG][eE][nN][tT]|[dD][eE][vV][iI][cC][eE][._-]+[nN][aA][mM][eE]|[sS][eE][tT]|[sS][eE][tT][._-]+[oO][nN][cC][eE]|[uU][nN][sS][eE][tT]|[eE][xX][cC][eE][pP][tT][iI][oO][nN]|[aA][nN][oO][nN][._-]+[dD][iI][sS][tT][iI][nN][cC][tT][._-]+[iI][dD]|[gG][rR][oO][uU][pP][sS])[._-]*$"
          }
        },
        {
          "not": {
            "pattern": "(?:^[$_@.-]*|[._-])(?:[eE][mM][aA][iI][lL]|[iI][pP]|[hH][oO][sS][tT][nN][aA][mM][eE]|[hH][oO][sS][tT][._-]+[nN][aA][mM][eE]|[dD][iI][sS][tT][iI][nN][cC][tT][._-]+[iI][dD])(?:[._-]|$)"
          }
        },
        {
          "not": {
            "pattern": "(?:^[$_@.-]*|[._-])(?:[rR][eE][aA][sS][oO][nN]|[sS][tT][aA][cC][kK]|[mM][eE][sS][sS][aA][gG][eE]|[pP][aA][tT][hH]|[tT][eE][xX][tT]|[pP][rR][oO][mM][pP][tT]|[sS][tT][aA][cC][kK][._-]+[tT][rR][aA][cC][eE])[._-]*$"
          }
        },
        {
          "not": {
            "pattern": "(?:[sS][tT][aA][cC][kK][tT][rR][aA][cC][eE])[._-]*$"
          }
        },
        {
          "not": {
            "pattern": "^[$_@.-]*(?:[uU][sS][eE][rR]|[eE][nN][dD][uU][sS][eE][rR]|[oO][mM][oO][._-]+[cC][oO][lL][lL][eE][cC][tT][oO][rR]|[eE][xX][cC][eE][pP][tT][iI][oO][nN]|[gG][eE][oO][iI][pP]|[iI][nN][iI][tT][iI][aA][lL]|[gG][rR][oO][uU][pP])[._-]+[^._-]"
          }
        }
      ]
    },
    "wireKey": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/fieldName"
        },
        {
          "$ref": "#/$defs/keyPattern"
        },
        {
          "not": {
            "pattern": "^\\$"
          }
        }
      ]
    },
    "posthogName": {
      "description": "A PostHog property name the relay emits: an alias, a projection or a derived property.",
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/fieldName"
        },
        {
          "pattern": "^\\$?[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,5}$"
        }
      ]
    },
    "projectionName": {
      "description": "Closed allowlist: the PostHog property names a resource projection may emit (today's clients). Anything else is rejected; fieldName stays as a second guard.",
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/fieldName"
        },
        {
          "enum": ["$os", "$os_version", "app_version", "arch", "os_platform", "os_version"]
        }
      ]
    },
    "derivedName": {
      "description": "Closed allowlist: the PostHog property names a derived property may emit. Anything else is rejected; fieldName stays as a second guard.",
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/fieldName"
        },
        {
          "enum": ["cost_usd"]
        }
      ]
    },
    "eventName": {
      "type": "string",
      "pattern": "^omo\\.[a-z][a-z0-9_]*$"
    },
    "attributeMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/wireKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/attribute"
      }
    },
    "attribute": {
      "type": "object",
      "required": ["type", "required"],
      "properties": {
        "type": {
          "enum": ["boolean", "number", "string"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "pattern": {
          "$ref": "#/$defs/safePattern"
        },
        "integer": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "required": {
          "type": "boolean"
        },
        "relay_only": {
          "type": "boolean"
        },
        "posthog_name": {
          "$ref": "#/$defs/posthogName"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": ["values"]
              },
              {
                "required": ["pattern"]
              }
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "required": ["min", "max"]
          }
        }
      ]
    },
    "safePattern": {
      "description": "The only regexes a string attribute may use (plan D-I: no free-text slot). Matched byte-exact; anything else must be an enum (values).",
      "oneOf": [
        {
          "title": "uuid",
          "const": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "title": "semver",
          "description": "MAJOR.MINOR.PATCH with at most one prerelease from a fixed set; no build metadata, no free suffix; every numeric part is at most 6 digits (the nightly/preview date is exactly 8).",
          "const": "^[0-9]{1,6}\\.[0-9]{1,6}\\.[0-9]{1,6}(-(alpha|beta|rc|dfa)\\.[0-9]{1,6}|-(nightly|preview)\\.[0-9]{8}\\.[0-9]{1,6}|-[0-9]{1,6})?$"
        },
        {
          "title": "sha256_hex",
          "const": "^[0-9a-f]{64}$"
        },
        {
          "title": "hex32",
          "const": "^[0-9a-f]{32}$"
        },
        {
          "title": "hex16",
          "const": "^[0-9a-f]{16}$"
        },
        {
          "title": "iso_date",
          "const": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "title": "os_version",
          "description": "Dotted digits only, each part at most 6 digits; clients send the bare release (the kernel suffix of os.release() is stripped).",
          "const": "^[0-9]{1,6}(\\.[0-9]{1,6}){1,3}$"
        },
        {
          "title": "os_version_desktop",
          "description": "The desktop's os.version: a closed OS family, a space and dotted digits, or unknown (ingest strips the family before storage).",
          "const": "^(unknown|macOS [0-9]+(\\.[0-9]+){0,2}|Windows [0-9]+\\.[0-9]+\\.[0-9]+|Linux [0-9]+\\.[0-9]+(\\.[0-9]+)?)$"
        }
      ]
    }
  }
}
