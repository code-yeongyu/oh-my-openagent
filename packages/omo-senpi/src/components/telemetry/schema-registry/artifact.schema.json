{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omo.dev/schemas/telemetry-artifact.schema.json",
  "title": "OmO telemetry product schema artifact",
  "description": "The per-product allowlist the collector pins (plan D-A, D-I, D-P). Every wire key matches keyPattern and none is forbidden; every string has values or a pattern from the fixed safePattern set; every number has min and max.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_format",
    "product",
    "schema_version",
    "proto_tag",
    "identity",
    "relay",
    "semconv_map_sha256",
    "resource",
    "scope",
    "events",
    "spans",
    "values",
    "sha256"
  ],
  "properties": {
    "artifact_format": {
      "const": 1
    },
    "product": {
      "type": "string",
      "enum": ["omo-senpi", "omo-cloud", "omo-desktop", "omo-service"]
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "proto_tag": {
      "type": "string",
      "pattern": "^v1\\.(?:[7-9]|[1-9][0-9])\\.[0-9]+$"
    },
    "identity": {
      "enum": ["install", "none"]
    },
    "relay": {
      "type": "boolean"
    },
    "semconv_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "resource": {
      "type": "object",
      "$ref": "#/$defs/attributeMap",
      "required": [
        "service.name",
        "service.version",
        "service.instance.id",
        "os.type",
        "host.arch",
        "telemetry.sdk.name",
        "telemetry.sdk.language",
        "telemetry.sdk.version",
        "omo.schema.version",
        "omo.surface",
        "omo.ci"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["omo-senpi", "omo-desktop", "omo-service", "omo-cloud"]
          }
        },
        "version": {
          "$ref": "#/$defs/safePattern"
        }
      }
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "type": "object",
        "$ref": "#/$defs/attributeMap",
        "required": ["log.record.uid"]
      }
    },
    "spans": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/attributeMap"
      }
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rows"],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "wire"],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "wire": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "resource_projections": {
      "description": "Per event: PostHog properties today's client sends on the event that the wire carries in the Resource (the relay copies them back).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/keyPattern"
        }
      }
    },
    "derived_properties": {
      "description": "Per event: PostHog properties the relay derives from a wire attribute instead of reading one (cost_usd = omo.cost.usd_1e4 / 1e4).",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/eventName"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["from", "divide_by"],
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/$defs/keyPattern"
            },
            "divide_by": {
              "type": "number"
            }
          }
        }
      }
    },
    "sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "keyPattern": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){0,5}$"
    },
    "forbiddenKeys": {
      "enum": [
        "omo.install_id",
        "install_id",
        "exception.message",
        "exception.stacktrace",
        "exception.type",
        "code.file.path",
        "code.filepath",
        "code.function.name",
        "code.stacktrace",
        "url.full",
        "url.path",
        "url.query",
        "client.address",
        "server.address",
        "network.peer.address",
        "gen_ai.input.messages",
        "gen_ai.output.messages",
        "gen_ai.prompt",
        "gen_ai.completion",
        "gen_ai.system_instructions",
        "gen_ai.tool.call.arguments",
        "gen_ai.tool.call.result",
        "host.name"
      ]
    },
    "wireKey": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/keyPattern"
        },
        {
          "not": {
            "$ref": "#/$defs/forbiddenKeys"
          }
        },
        {
          "not": {
            "pattern": "_(?:text|path|prompt)$"
          }
        },
        {
          "not": {
            "pattern": "^\\$"
          }
        },
        {
          "not": {
            "pattern": "^(?:user|enduser|omo\\.collector)\\."
          }
        },
        {
          "not": {
            "pattern": "(?:^|\\.)(?:reason|stack|message|email|ip|hostname|path)$"
          }
        }
      ]
    },
    "eventName": {
      "type": "string",
      "pattern": "^omo\\.[a-z][a-z0-9_]*$"
    },
    "attributeMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/wireKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/attribute"
      }
    },
    "attribute": {
      "type": "object",
      "required": ["type", "required"],
      "properties": {
        "type": {
          "enum": ["boolean", "number", "string"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "pattern": {
          "$ref": "#/$defs/safePattern"
        },
        "integer": {
          "type": "boolean"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "required": {
          "type": "boolean"
        },
        "relay_only": {
          "type": "boolean"
        },
        "posthog_name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "required": ["values"]
              },
              {
                "required": ["pattern"]
              }
            ]
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "required": ["min", "max"]
          }
        }
      ]
    },
    "safePattern": {
      "description": "The only regexes a string attribute may use (plan D-I: no free-text slot). Matched byte-exact; anything else must be an enum (values).",
      "oneOf": [
        {
          "title": "uuid",
          "const": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "title": "semver",
          "const": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        {
          "title": "sha256_hex",
          "const": "^[0-9a-f]{64}$"
        },
        {
          "title": "hex32",
          "const": "^[0-9a-f]{32}$"
        },
        {
          "title": "hex16",
          "const": "^[0-9a-f]{16}$"
        },
        {
          "title": "iso_date",
          "const": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "title": "os_version",
          "const": "^[0-9]+(\\.[0-9]+){1,3}(-[0-9A-Za-z.-]{1,32})?$"
        },
        {
          "title": "os_version_desktop",
          "description": "The desktop's os.version: a closed OS family plus digits, or unknown (ingest strips the family before storage).",
          "const": "^(unknown|macOS [0-9]+(\\.[0-9]+){0,2}|Windows [0-9]+\\.[0-9]+\\.[0-9]+|Linux [0-9]+\\.[0-9]+(\\.[0-9]+)?)$"
        }
      ]
    }
  }
}
