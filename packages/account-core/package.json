{
  "name": "@oh-my-opencode/account-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "The omo account domain core: session, credential store, device-code flow, device keys and the device keyring.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "bun check --no-script --all -p tsconfig.json",
    "test": "bun test src/**/*.test.ts"
  },
  "dependencies": {
    "@oh-my-opencode/device-service-core": "workspace:*",
    "@oh-my-opencode/memory-core": "workspace:*",
    "@oh-my-opencode/team-core": "workspace:*",
    "@oh-my-opencode/utils": "workspace:*",
    "zod": "^4.6.6"
  }
}
