{
  "name": "@oh-my-opencode/telemetry-core",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Harness-neutral telemetry primitives for oh-my-opencode products.",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.ts"
