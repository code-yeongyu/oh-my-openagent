  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@oh-my-opencode/utils": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "posthog-node": "^5.52.4"
