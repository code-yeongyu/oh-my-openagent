// knip config owned by this directory, composed by the root knip.ts (script/knip-config.ts).
{
  "workspaces": {
    "packages/openclaw-core": {
      "includeEntryExports": true,
      // knip's default entry patterns (an explicit "entry" replaces them), files run by path from package.json scripts or CI
      // workflows, and the test, config and helper files plugins report with exports unchecked: listing them export-checks
      // them too (script/knip-entry-exports.test.ts probes every knip entry and fails on one that is missing).
      "entry": [
        "{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "src/{index,cli,main}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.{test,spec}.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
        "**/*.test-d.ts",
        "src/reply-listener-injection.ts",
        "src/reply-listener-start.ts",
        "src/reply-listener.ts",
      ],
    }
  },
  "preExistingExports": {
    // pre-existing at origin dev 4686e425b5: unused export(s) startReplyListener, stopReplyListener
    "packages/openclaw-core/src/index.ts": ["startReplyListener", "stopReplyListener"],
    // pre-existing at origin dev 4686e425b5: unused export(s) getReplyListenerStateDir
    "packages/openclaw-core/src/reply-listener-paths.ts": ["getReplyListenerStateDir"],
    // pre-existing at origin dev 4686e425b5: unused export(s) getOpenCodeStorageDir, getOpenClawStorageDir
    "packages/openclaw-core/src/session-registry-paths.ts": ["getOpenCodeStorageDir", "getOpenClawStorageDir"],
    // pre-existing at origin dev 4686e425b5: unused export(s) resetTmuxPathCacheForTesting
    "packages/openclaw-core/src/tmux-path.ts": ["resetTmuxPathCacheForTesting"],
    // pre-existing at origin dev 4686e425b5: unused export(s) getTmuxSessionName
    "packages/openclaw-core/src/tmux.ts": ["getTmuxSessionName"]
  }
}
