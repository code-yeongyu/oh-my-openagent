{
	"name": "@oh-my-opencode/senpi-desktop-engine",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"description": "Locator, ABI handshake, and dev-build fallback for the senpi-desktop-engine binary",
	"exports": {
