			},
			"required": [
				"target"
			],
			"description": "`capture`: one target (`desktop` or a window id) under optional caps.",
			"additionalProperties": false,
			"definitions": {
				"CaptureCaps": {
					"type": "object",
					"properties": {
						"maxWidth": {
							"type": [
								"integer",
								"null"
							],
							"format": "uint32",
							"minimum": 0,
							"default": null
						},
						"maxHeight": {
							"type": [
								"integer",
								"null"
							],
							"format": "uint32",
							"minimum": 0,
							"default": null
						},
						"coordinateSafe": {
							"type": "boolean",
							"description": "Clamp to the coordinate-safe size for models that click in image pixels.",
							"default": false
						},
						"maxBytes": {
							"type": "integer",
							"format": "uint64",
							"minimum": 0,
							"description": "Inline byte budget; above it the capture degrades to JPEG, then artifact-only.",
							"default": 5000000
						}
					},
					"additionalProperties": false
				}
			}
		},
