#!/bin/sh
# post-checkout guard for the OMO local-fix bundle.
#
# Leaving local/bundle-all silently disarms every local fix: dist/index.js gets
# rebuilt from a tree that does not carry them, and opencode.json loads it anyway.
# This warns the moment it happens instead of hours later.
#
# Installed by: node local-fixes/install-hooks.mjs
# Git passes: $1=prev HEAD  $2=new HEAD  $3=1 for branch checkout, 0 for file checkout

prev_head="$1"
new_head="$2"
is_branch_checkout="$3"

# Only act on real branch switches.
[ "$is_branch_checkout" = "1" ] || exit 0

expected="integration/opencode-v2"
current=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

[ "$current" = "$expected" ] && exit 0

# Detached HEAD during rebase/bisect is noisy; only warn for named branches.
[ "$current" = "HEAD" ] && exit 0

printf '\n' >&2
printf '  \033[33mOMO GUARD\033[0m  checked out "%s", not "%s".\n' "$current" "$expected" >&2
printf '            The local fixes are NOT on this branch.\n' >&2
printf '            dist/index.js will lose them on the next build.\n' >&2
printf '            Return with:  git checkout %s  &&  bun run fixes:apply\n' "$expected" >&2
printf '            Check any time with:  bun run fixes:verify\n' >&2
printf '\n' >&2

exit 0
