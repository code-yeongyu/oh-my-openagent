From 4dcc1b377e4a8602aec00ddc47b03146f77971ee Mon Sep 17 00:00:00 2001
From: "Mohamed R. Khalil" <m.radwan.khalil@gmail.com>
Date: Sat, 10 Oct 2026 03:22:48 +0300
Subject: [PATCH] fix(hooks): hide console windows for shell hook children

---
 packages/utils/src/command-executor/execute-hook-command.ts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/packages/utils/src/command-executor/execute-hook-command.ts b/packages/utils/src/command-executor/execute-hook-command.ts
index 0d90698f6..22e1ed3b6 100644
--- a/packages/utils/src/command-executor/execute-hook-command.ts
+++ b/packages/utils/src/command-executor/execute-hook-command.ts
@@ -10,6 +10,7 @@ export interface CommandResult {
 
 const DEFAULT_HOOK_TIMEOUT_MS = 30_000;
 const SIGKILL_GRACE_MS = 5_000;
+const HOOK_SPAWN_WINDOWSHIDE = true;
 
 export interface ExecuteHookOptions {
   forceZsh?: boolean;
@@ -102,6 +103,7 @@ export async function executeHookCommand(
     const proc = spawn(finalCommand, {
       cwd,
       shell: true,
+      windowsHide: HOOK_SPAWN_WINDOWSHIDE,
       detached: !isWin32,
       env,
     });
-- 
2.55.0.windows.3

