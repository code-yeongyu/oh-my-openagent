+export const TRANSCRIPT_FAILURE_RETRY_MS = 60 * 1000 // 1 minute
 const TRANSCRIPT_CACHE_PRUNE_INTERVAL_MS = TRANSCRIPT_CACHE_TTL_MS
 
 const transcriptCache = new Map<string, TranscriptCacheEntry>()
