+/// <reference types="bun-types" />
+
+import { beforeEach, describe, expect, test } from "bun:test"
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import {
+  NO_PROJECT_SOURCES_FINGERPRINT,
+  fingerprintProjectSources,
+  getProcessConfigCacheEntry,
+  isProcessConfigCacheDisabled,
+  resetProcessConfigCacheForTests,
+  setProcessConfigCacheEntry,
+} from "./process-config-cache"
+
+describe("process-config-cache", () => {
+  let tempRoot: string
+
+  beforeEach(() => {
+    resetProcessConfigCacheForTests()
+    delete process.env.OMO_DISABLE_PROCESS_CONFIG_CACHE
+    tempRoot = mkdtempSync(join(tmpdir(), "omo-pcc-"))
+  })
+
+  test("empty folder fingerprints to the shared no-project-sources constant", () => {
+    const emptyFolder = join(tempRoot, "empty-chat-folder")
+    mkdirSync(emptyFolder)
+
+    expect(fingerprintProjectSources(emptyFolder)).toBe(NO_PROJECT_SOURCES_FINGERPRINT)
+  })
+
+  test("two distinct empty folders share the same fingerprint", () => {
+    const folderA = join(tempRoot, "chat-a")
+    const folderB = join(tempRoot, "chat-b")
+    mkdirSync(folderA)
+    mkdirSync(folderB)
+
+    expect(fingerprintProjectSources(folderA)).toBe(fingerprintProjectSources(folderB))
+  })
+
+  test("a folder with project sources is keyed by directory and content", () => {
+    const folderA = join(tempRoot, "project-a")
+    const folderB = join(tempRoot, "project-b")
+    mkdirSync(join(folderA, ".claude", "agents"), { recursive: true })
+    writeFileSync(join(folderA, ".claude", "agents", "helper.md"), "agent")
+    mkdirSync(join(folderB, ".claude", "agents"), { recursive: true })
+    writeFileSync(join(folderB, ".claude", "agents", "helper.md"), "agent")
+
+    const fingerprintA = fingerprintProjectSources(folderA)
+    const fingerprintB = fingerprintProjectSources(folderB)
+
+    // same content, different directory -> different keys (per-folder isolation)
+    expect(fingerprintA.startsWith("dir:")).toBe(true)
+    expect(fingerprintB.startsWith("dir:")).toBe(true)
+    expect(fingerprintA).not.toBe(fingerprintB)
+  })
+
+  test("adding or removing a project source entry changes the fingerprint", () => {
+    const folder = join(tempRoot, "project")
+    mkdirSync(join(folder, ".claude"), { recursive: true })
+    const before = fingerprintProjectSources(folder)
+
+    // a new entry under a project root changes the directory listing
+    mkdirSync(join(folder, ".claude", "agents"))
+    const afterAdd = fingerprintProjectSources(folder)
+    expect(afterAdd).not.toBe(before)
+
+    // removing the entry changes the fingerprint again (the directory stat
+    // keeps the mutation), which still invalidates the cache correctly.
+    rmSync(join(folder, ".claude", "agents"), { recursive: true, force: true })
+    expect(fingerprintProjectSources(folder)).not.toBe(afterAdd)
+  })
+
+  // Known limitation (documented in the fix report): an in-place edit of a
+  // file inside an existing project source directory does not change the
+  // directory stat or listing, so it does not invalidate the snapshot; the
+  // OpenCode config key, a config.updated cycle, a process restart, or
+  // OMO_DISABLE_PROCESS_CONFIG_CACHE=1 remain the invalidation paths.
+
+  test("entries round-trip and reset clears them", () => {
+    setProcessConfigCacheEntry("pluginComponents", { key: "k1", value: { hello: 1 } })
+    expect(getProcessConfigCacheEntry("pluginComponents")?.key).toBe("k1")
+
+    resetProcessConfigCacheForTests()
+    expect(getProcessConfigCacheEntry("pluginComponents")).toBeUndefined()
+  })
+
+  test("OMO_DISABLE_PROCESS_CONFIG_CACHE=1 disables reads and writes", () => {
+    process.env.OMO_DISABLE_PROCESS_CONFIG_CACHE = "1"
+    expect(isProcessConfigCacheDisabled()).toBe(true)
+
+    setProcessConfigCacheEntry("pluginComponents", { key: "k1", value: {} })
+    expect(getProcessConfigCacheEntry("pluginComponents")).toBeUndefined()
+  })
+
+  test("state survives a fresh import of the module (module re-import safety)", async () => {
+    setProcessConfigCacheEntry("globalCommandSources", { key: "k2", value: { n: 2 } })
+    // A per-location plugin module re-import in the same process must keep the
+    // cache: it lives on globalThis behind a registered symbol, not module scope.
+    const moduleUrl = new URL("./process-config-cache.ts", import.meta.url).href + "?reimport=1"
+    await import(moduleUrl)
+    expect(getProcessConfigCacheEntry("globalCommandSources")?.key).toBe("k2")
+  })
+})
diff --git a/packages/omo-opencode/src/shared/process-config-cache.ts b/packages/omo-opencode/src/shared/process-config-cache.ts
new file mode 100644
index 000000000..ba150fbc9
--- /dev/null
+++ b/packages/omo-opencode/src/shared/process-config-cache.ts
@@ -0,0 +1,168 @@
+import { readdirSync, statSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+
+/**
+ * Process-level cache for configuration artifacts that are identical across
+ * chat folders (local fix 28, first-message-drop F5c).
+ *
+ * OpenCode creates one plugin instance per folder and rebuilds instances on
+ * release/eviction. Every rebuild used to re-pay the full cold config-handler
+ * cost (measured 11.7s of a 17.7s cold plugin setup), even though plugin
+ * components, agents, commands and MCP config are identical for every chat
+ * folder.
+ *
+ * State lives on `globalThis` behind a registered symbol so it survives
+ * per-location plugin module re-imports within one OpenCode process but never
+ * leaks across processes. Each entry carries its own key derived from the
+ * inputs that produced it (config slices + filesystem fingerprints), so a real
+ * change misses the cache and recomputes.
+ *
+ * Escape hatch: set OMO_DISABLE_PROCESS_CONFIG_CACHE=1 to disable all reads
+ * and writes (each call recomputes, exactly the pre-fix behavior).
+ */
+
+const PROCESS_CONFIG_CACHE_SYMBOL = Symbol.for("omo.processConfigCache.v1");
+
+export type PluginComponentsCacheEntry = {
+  key: string;
+  value: unknown;
+};
+
+export type ProcessConfigCacheEntries = {
+  pluginComponents?: PluginComponentsCacheEntry;
+  agentSnapshots?: Map<string, unknown>;
+  globalCommandSources?: PluginComponentsCacheEntry;
+  claudeMcpServers?: PluginComponentsCacheEntry;
+};
+
+type ProcessConfigCacheState = {
+  entries: ProcessConfigCacheEntries;
+};
+
+export function isProcessConfigCacheDisabled(): boolean {
+  return process.env.OMO_DISABLE_PROCESS_CONFIG_CACHE === "1";
+}
+
+function getProcessState(): ProcessConfigCacheState {
+  const holder = globalThis as Record<symbol, unknown>;
+  let state = holder[PROCESS_CONFIG_CACHE_SYMBOL] as ProcessConfigCacheState | undefined;
+  if (state === undefined) {
+    state = { entries: {} };
+    holder[PROCESS_CONFIG_CACHE_SYMBOL] = state;
+  }
+  return state;
+}
+
+export function getProcessConfigCacheEntry<K extends keyof ProcessConfigCacheEntries>(
+  name: K,
+): ProcessConfigCacheEntries[K] | undefined {
+  if (isProcessConfigCacheDisabled()) return undefined;
+  return getProcessState().entries[name];
+}
+
+export function setProcessConfigCacheEntry<K extends keyof ProcessConfigCacheEntries>(
+  name: K,
+  value: ProcessConfigCacheEntries[K],
+): void {
+  if (isProcessConfigCacheDisabled()) return;
+  getProcessState().entries[name] = value;
+}
+
+export function getProcessAgentSnapshotMap(): Map<string, unknown> {
+  const existing = getProcessConfigCacheEntry("agentSnapshots");
+  if (existing instanceof Map) return existing;
+  const created = new Map<string, unknown>();
+  setProcessConfigCacheEntry("agentSnapshots", created);
+  return created;
+}
+
+/** Test-only: drop every process-level config cache entry. */
+export function resetProcessConfigCacheForTests(): void {
+  const holder = globalThis as Record<symbol, unknown>;
+  delete holder[PROCESS_CONFIG_CACHE_SYMBOL];
+}
+
+function describeStat(path: string): string {
+  try {
+    const stats = statSync(path);
+    return `${stats.mtimeMs}:${stats.size}`;
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException)?.code ?? "unknown";
+    return code === "ENOENT" ? "absent" : `stat-error:${code}`;
+  }
+}
+
+function describeDir(path: string): string {
+  const statPart = describeStat(path);
+  if (statPart === "absent" || statPart.startsWith("stat-error:")) {
+    return statPart;
+  }
+  try {
+    const entries = readdirSync(path).sort();
+    return `${statPart}:[${entries.join("|")}]`;
+  } catch (error) {
+    const code = (error as NodeJS.ErrnoException)?.code ?? "unknown";
+    return `${statPart}:readdir-error:${code}`;
+  }
+}
+
+/**
+ * Fingerprint the project-level sources the config-handler loaders read from a
+ * folder. Folders where none of these roots exist (every OpenChamber chat
+ * folder is an empty directory) contribute nothing loader-visible, so they all
+ * map to the constant "no-project-sources" signature and can share cached
+ * config artifacts. Any folder with at least one root is keyed by directory +
+ * full signature instead.
+ */
+const PROJECT_SOURCE_ROOTS = [
+  ".claude",
+  ".opencode",
+  "opencode",
+  "agents",
+  "skills",
+  "commands",
+  ".mcp.json",
+  "opencode.json",
+  "opencode.jsonc",
+  "AGENTS.md",
+  "CLAUDE.md",
+] as const;
+
+export const NO_PROJECT_SOURCES_FINGERPRINT = "no-project-sources";
+
+export function fingerprintProjectSources(directory: string): string {
+  const present: Array<string> = [];
+  for (const root of PROJECT_SOURCE_ROOTS) {
+    try {
+      statSync(join(directory, root));
+      present.push(root);
+    } catch {
+      // not present in this folder
+    }
+  }
+  if (present.length === 0) {
+    return NO_PROJECT_SOURCES_FINGERPRINT;
+  }
+  const details = present.map((root) => `${root}=${describeDir(join(directory, root))}`);
+  return `dir:${directory}:${details.join(";")}`;
+}
+
+/** Fingerprint the Claude Code plugin installation roots (~/.claude/plugins). */
+export function fingerprintClaudePluginRoots(): string {
+  const home = homedir();
+  return [
+    describeDir(join(home, ".claude", "plugins")),
+    describeStat(join(home, ".claude", "plugins", "installed_plugins.json")),
+    describeStat(join(home, ".claude", "settings.json")),
+  ].join(";");
+}
+
+/** Fingerprint the global files the Claude Code MCP loader reads. */
+export function fingerprintClaudeMcpSources(): string {
+  const home = homedir();
+  return [
+    describeStat(join(home, ".claude.json")),
+    describeStat(join(home, ".claude", "settings.json")),
+  ].join(";");
+}
