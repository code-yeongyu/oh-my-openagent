From 1f9b48ef2aedbe7ec36368d2a15b9a742c682aa0 Mon Sep 17 00:00:00 2001
From: "Mohamed R. Khalil" <m.radwan.khalil@gmail.com>
Date: Thu, 15 Oct 2026 03:39:11 +0300
Subject: [PATCH] fix(opencode-v2): write hook message edits back by identity,
 not index

The V2 hook bridge runs the V1 experimental.chat.messages.transform chain
on a V1 view of the context messages and writes the result back with
writeHookMessagesBack. That function paired edited messages with the
originals by array index. A transform that inserts a message (the
team-mode status, monitor status and team mailbox injectors splice one
in before the latest user message; btw-side prepends parent context)
shifts every later view by one, so each later original received its
predecessor's parts.

When the latest user-role message sits between tool steps (for example
an instruction file pulled in by a read), the assistant's reasoning and
tool-call parts land in the following tool message. Every OpenCode V2
route rejects that request ("OpenAI Responses tool messages only support
tool-result content for now", "Anthropic Messages ..."), and the turn
fails to drain on every provider until a new user prompt moves the
insertion point.

Remember the source message of each view and write edits back to it.
Inserted views still become new messages, removed views drop their
originals, and in-place part edits keep reaching the original message.
---
 .../omo-opencode/src/v2/message-shape.test.ts | 87 +++++++++++++++++++
 packages/omo-opencode/src/v2/message-shape.ts | 51 +++++++----
 2 files changed, 119 insertions(+), 19 deletions(-)
 create mode 100644 packages/omo-opencode/src/v2/message-shape.test.ts

diff --git a/packages/omo-opencode/src/v2/message-shape.test.ts b/packages/omo-opencode/src/v2/message-shape.test.ts
new file mode 100644
index 000000000..e7dc652ff
--- /dev/null
+++ b/packages/omo-opencode/src/v2/message-shape.test.ts
@@ -0,0 +1,87 @@
+import { describe, expect, test } from "bun:test"
+import { TeamModeConfigSchema } from "../config/schema/team-mode"
+import { createTeamModeStatusInjector } from "../hooks/team-mode-status-injector"
+import { hookMessagesToV1, writeHookMessagesBack } from "./message-shape"
+
+type Message = { id?: string; role: string; content: Array<Record<string, unknown>> }
+
+// Provider history of an agent loop after a read pulled in instructions: the latest
+// user-role message sits between two tool steps.
+function history(): Message[] {
+  return [
+    { id: "msg_1", role: "user", content: [{ type: "text", text: "Implement the plan." }] },
+    { id: "msg_2", role: "assistant", content: [{ type: "tool-call", id: "call_1", name: "read" }] },
+    { role: "tool", content: [{ type: "tool-result", id: "call_1", name: "read" }] },
+    { id: "msg_3", role: "user", content: [{ type: "text", text: "Instructions from: AGENTS.md\nUse team mode for audits." }] },
+    {
+      id: "msg_4",
+      role: "assistant",
+      content: [
+        { type: "reasoning", text: "Run the tests." },
+        { type: "tool-call", id: "call_2", name: "shell" },
+      ],
+    },
+    { role: "tool", content: [{ type: "tool-result", id: "call_2", name: "shell" }] },
+  ]
+}
+
+function shape(messages: Message[]): string[] {
+  return messages.map((message) => `${message.role}[${message.content.map((part) => part.type).join(",")}]`)
+}
+
+describe("writeHookMessagesBack", () => {
+  test("writes the messages after an inserted one back to the messages they came from", () => {
+    const messages = history()
+    const view = hookMessagesToV1(messages, "ses_1")
+    view.splice(3, 0, {
+      info: { sessionID: "ses_1", role: "user" },
+      parts: [{ type: "text", text: "<status/>", synthetic: true }],
+    })
+
+    const next = writeHookMessagesBack(messages, view)
+
+    expect(shape(next)).toEqual([
+      "user[text]",
+      "assistant[tool-call]",
+      "tool[tool-result]",
+      "user[text]",
+      "user[text]",
+      "assistant[reasoning,tool-call]",
+      "tool[tool-result]",
+    ])
+    expect(next[4]).toBe(messages[3])
+    expect(next[5]).toBe(messages[4])
+    expect(next[6]).toBe(messages[5])
+  })
+
+  test("keeps the team-mode status injection from moving tool calls into a tool message", async () => {
+    const messages = history()
+    const view = hookMessagesToV1(messages, "ses_1")
+    const injector = createTeamModeStatusInjector(TeamModeConfigSchema.parse({ enabled: true }))
+    await injector["experimental.chat.messages.transform"]?.({ sessionID: "ses_1" }, { messages: view as never })
+    expect(view).toHaveLength(messages.length + 1)
+
+    const next = writeHookMessagesBack(messages, view)
+
+    const toolParts = next.filter((message) => message.role === "tool").flatMap((message) => message.content)
+    expect(toolParts.map((part) => part.type)).toEqual(["tool-result", "tool-result"])
+    expect(next.at(-2)?.content.map((part) => part.type)).toEqual(["reasoning", "tool-call"])
+  })
+
+  test("writes in-place part edits back and drops removed messages", () => {
+    const messages = history()
+    const view = hookMessagesToV1(messages, "ses_1")
+    view[3]?.parts.unshift({ type: "text", text: "<reminder/>", synthetic: true })
+    view.splice(0, 1)
+
+    const next = writeHookMessagesBack(messages, view)
+
+    expect(next).toHaveLength(messages.length - 1)
+    expect(next[0]).toBe(messages[1])
+    expect(next[2]).toBe(messages[3])
+    expect(messages[3]?.content.map((part) => part.text)).toEqual([
+      "<reminder/>",
+      "Instructions from: AGENTS.md\nUse team mode for audits.",
+    ])
+  })
+})
diff --git a/packages/omo-opencode/src/v2/message-shape.ts b/packages/omo-opencode/src/v2/message-shape.ts
index 4bbe91ae8..b75e62958 100644
--- a/packages/omo-opencode/src/v2/message-shape.ts
+++ b/packages/omo-opencode/src/v2/message-shape.ts
@@ -90,32 +90,45 @@ export function storedMessagesToV1(messages: unknown, sessionID: string): V1Mess
   return view
 }
 
+// The message each v1 view was made from. Transforms insert, drop and reorder views, so edits are
+// written back to the message a view came from, never to whatever sits at the view's index.
+const viewSources = new WeakMap<V1Message, unknown>()
+
+function hookMessageToV1(message: unknown, sessionID: string): V1Message {
+  if (!isRecord(message)) {
+    return { info: { sessionID, role: "user" }, parts: textPart("") }
+  }
+  if (typeof message.type === "string" && message.role === undefined) {
+    return storedMessage(message, sessionID) ?? { info: { sessionID, role: "user" }, parts: textPart("") }
+  }
+  return {
+    info: {
+      id: message.id,
+      sessionID,
+      role: message.role,
+      ...(message.agent !== undefined ? { agent: message.agent } : {}),
+      ...(message.model !== undefined ? { model: message.model } : {}),
+    },
+    parts: Array.isArray(message.content) ? partsFromContent(message.content) : partsFromContent(message.parts),
+  }
+}
+
 export function hookMessagesToV1(messages: readonly unknown[], sessionID: string): V1Message[] {
   return messages.map((message) => {
-    if (!isRecord(message)) {
-      return { info: { sessionID, role: "user" }, parts: textPart("") }
-    }
-    if (typeof message.type === "string" && message.role === undefined) {
-      return storedMessage(message, sessionID) ?? { info: { sessionID, role: "user" }, parts: textPart("") }
-    }
-    return {
-      info: {
-        id: message.id,
-        sessionID,
-        role: message.role,
-        ...(message.agent !== undefined ? { agent: message.agent } : {}),
-        ...(message.model !== undefined ? { model: message.model } : {}),
-      },
-      parts: Array.isArray(message.content) ? partsFromContent(message.content) : partsFromContent(message.parts),
-    }
+    const view = hookMessageToV1(message, sessionID)
+    viewSources.set(view, message)
+    return view
   })
 }
 
 export function writeHookMessagesBack<T>(original: readonly T[], edited: readonly V1Message[]): T[] {
-  return edited.map((message, index) => {
-    const current = original[index]
+  const written = new Set<T>()
+  return edited.map((message) => {
+    const source = viewSources.get(message) as T | undefined
+    const current = source !== undefined && original.includes(source) && !written.has(source) ? source : undefined
     const content = contentFromParts(message.parts)
-    if (isRecord(current) && Array.isArray(current.content)) {
+    if (current !== undefined && isRecord(current) && Array.isArray(current.content)) {
+      written.add(current)
       current.content.splice(0, current.content.length, ...content)
       return current
     }
