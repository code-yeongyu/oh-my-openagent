 .../claude-code-agent-loader/loader.ts        | 53 +++++++++++++++-
 .../src/v2/agent-markdown.test.ts             | 60 +++++++++++++++++++
 .../omo-opencode/src/v2/agent-markdown.ts     | 34 ++++++++++-
 4 files changed, 199 insertions(+), 5 deletions(-)
 create mode 100644 packages/omo-opencode/src/v2/agent-markdown.test.ts

