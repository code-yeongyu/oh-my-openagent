   const delivery = promptDelivery(input)
-  return api.prompt({ sessionID, text, ...(delivery ? { delivery } : {}) })
+  return api.prompt({ sessionID, text, ...(delivery ? { delivery } : {}), ...(files.length > 0 ? { files } : {}) })
 }
 
