From 4e70e0e416ad94fc488d0696176d5ee80dfc72e3 Mon Sep 17 00:00:00 2001
From: "Mohamed R. Khalil" <m.radwan.khalil@gmail.com>
Date: Mon, 19 Oct 2026 20:54:07 +0300
Subject: [PATCH] fix(hooks): retain Claude plugin identity on loaded hook
 actions

Signed-off-by: Mohamed R. Khalil <m.radwan.khalil@gmail.com>
---
 .../features/claude-code-plugin-loader/hook-loader.test.ts   | 2 ++
 .../src/features/claude-code-plugin-loader/hook-loader.ts    | 5 +++--
 .../src/features/claude-code-plugin-loader/types.ts          | 4 ++--
 3 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.test.ts b/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.test.ts
index edf9edf2c..122c0133e 100644
--- a/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.test.ts
+++ b/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.test.ts
@@ -67,6 +67,7 @@ describe("loadPluginHooksConfigs pluginRoot stamping (#4458)", () => {
       expect(action.type).toBe("command")
       // Type narrowing for the test: command-type entries should carry pluginRoot.
       expect((action as { pluginRoot?: string }).pluginRoot).toBe(plugin.installPath)
+      expect((action as { pluginName?: string }).pluginName).toBe(plugin.name)
     }
   })
 
@@ -92,5 +93,6 @@ describe("loadPluginHooksConfigs pluginRoot stamping (#4458)", () => {
     const action = configs[0]?.hooks?.PostToolUse?.[0]?.hooks?.[0]
     expect(action?.type).toBe("http")
     expect((action as { pluginRoot?: string }).pluginRoot).toBe(plugin.installPath)
+    expect((action as { pluginName?: string }).pluginName).toBe(plugin.name)
   })
 })
diff --git a/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.ts b/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.ts
index 74267dff5..1364ef1b3 100644
--- a/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.ts
+++ b/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/hook-loader.ts
@@ -8,7 +8,7 @@ import { resolvePluginPaths } from "./plugin-path-resolver"
  * dispatcher can set CLAUDE_PLUGIN_ROOT on the spawned hook process (#4458).
  * The plugin association is otherwise lost once configs are merged together.
  */
-function stampPluginRoot(config: HooksConfig, pluginRoot: string): void {
+function stampPluginRoot(config: HooksConfig, pluginRoot: string, pluginName: string): void {
   const eventMap = config.hooks
   if (!eventMap) return
   for (const matchers of Object.values(eventMap)) {
@@ -18,6 +18,7 @@ function stampPluginRoot(config: HooksConfig, pluginRoot: string): void {
       for (const action of matcher.hooks as HookEntry[]) {
         if (action && (action.type === "command" || action.type === "http")) {
           action.pluginRoot = pluginRoot
+          action.pluginName = pluginName
         }
       }
     }
@@ -35,7 +36,7 @@ export function loadPluginHooksConfigs(plugins: LoadedPlugin[]): HooksConfig[] {
       let config = JSON.parse(content) as HooksConfig
 
       config = resolvePluginPaths(config, plugin.installPath)
-      stampPluginRoot(config, plugin.installPath)
+      stampPluginRoot(config, plugin.installPath, plugin.name)
 
       configs.push(config)
       log(`Loaded plugin hooks config from ${plugin.name}`, { path: plugin.hooksPath })
diff --git a/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/types.ts b/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/types.ts
index 04e5ca546..bdea92060 100644
--- a/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/types.ts
+++ b/packages/claude-code-compat-core/src/features/claude-code-plugin-loader/types.ts
@@ -115,10 +115,10 @@ export interface PluginManifest {
  * Hooks configuration
  */
 export type HookEntry =
-  | { type: "command"; command?: string; allowedEnvVars?: string[]; pluginRoot?: string }
+  | { type: "command"; command?: string; allowedEnvVars?: string[]; pluginRoot?: string; pluginName?: string }
   | { type: "prompt"; prompt?: string }
   | { type: "agent"; agent?: string }
-  | { type: "http"; url: string; headers?: Record<string, string>; allowedEnvVars?: string[]; timeout?: number; pluginRoot?: string }
+  | { type: "http"; url: string; headers?: Record<string, string>; allowedEnvVars?: string[]; timeout?: number; pluginRoot?: string; pluginName?: string }
 
 export interface HookMatcher {
   matcher?: string
-- 
2.55.0.windows.5

