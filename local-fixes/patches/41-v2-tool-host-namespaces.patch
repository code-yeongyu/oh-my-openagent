--- a/packages/omo-opencode/src/hooks/claude-code-hooks/dispatch-hook.test.ts
+++ b/packages/omo-opencode/src/hooks/claude-code-hooks/dispatch-hook.test.ts
@@ -29,6 +29,18 @@ afterAll(() => {
 })
 
 describe("dispatchHook", () => {
+  test("identifies the actual hook host without changing tool inputs", async () => {
+    const payload = { tool_name: "WebFetch", tool_input: { url: "https://example.com" } }
+    await dispatchHook({ type: "command", command: "echo hello" }, JSON.stringify(payload), "/tmp")
+    const stdin = mockExecuteHookCommand.mock.calls.at(-1)?.[1]
+    expect(JSON.parse(stdin!)).toEqual({ ...payload, hook_host: "opencode" })
+  })
+
+  test.each(["plain custom input", "[]", "null"])("preserves non-object payload %s", async (stdin: string) => {
+    await dispatchHook({ type: "command", command: "echo hello" }, stdin, "/tmp")
+    expect(mockExecuteHookCommand.mock.calls.at(-1)?.[1]).toBe(stdin)
+  })
+
   beforeEach(() => {
     mockExecuteHookCommand.mockClear()
     capturedOptions.length = 0
diff --git a/packages/omo-opencode/src/hooks/claude-code-hooks/dispatch-hook.ts b/packages/omo-opencode/src/hooks/claude-code-hooks/dispatch-hook.ts
index 345b03686..a0ab88f6a 100644
--- a/packages/omo-opencode/src/hooks/claude-code-hooks/dispatch-hook.ts
+++ b/packages/omo-opencode/src/hooks/claude-code-hooks/dispatch-hook.ts
@@ -14,6 +14,16 @@ export async function dispatchHook(
   stdinJson: string,
   cwd: string
 ): Promise<CommandResult> {
+  // Claude-compatible envelopes do not imply Claude's tool namespace. Let
+  // shared hooks select OpenCode guidance without guessing from inherited env.
+  try {
+    const input = JSON.parse(stdinJson)
+    if (input && typeof input === "object" && !Array.isArray(input)) {
+      stdinJson = JSON.stringify({ ...input, hook_host: "opencode" })
+    }
+  } catch {
+    // Preserve the existing behavior for non-JSON custom hooks.
+  }
   if (hook.type === "http") {
     return executeHttpHook(hook, stdinJson)
   }
diff --git a/packages/omo-opencode/src/plugin/tool-execute-before-mcp-prefix.test.ts b/packages/omo-opencode/src/plugin/tool-execute-before-mcp-prefix.test.ts
