--- a/packages/omo-opencode/src/hooks/auto-update-checker/hook.ts
+++ b/packages/omo-opencode/src/hooks/auto-update-checker/hook.ts
@@ -12,6 +12,7 @@ import { refreshModelCapabilitiesOnStartup } from "./hook/model-capabilities-sta
 import { showModelCacheWarningIfNeeded } from "./hook/model-cache-warning"
 import { showLocalDevToast, showVersionToast } from "./hook/startup-toasts"
 import { ignoreToastError } from "./hook/ignore-toast-error"
+import { getStartupCheckProcessState } from "./startup-check-process-state"
 
 interface AutoUpdateCheckerDeps {
   getBundledVersion?: typeof getBundledVersion
@@ -89,7 +90,16 @@ export function createAutoUpdateCheckerHook(
       if (hasChecked || hasScheduled) return
       if (getParentID(event.properties)) return
 
+      const processState = getStartupCheckProcessState()
+      if (processState.completed || processState.running) {
+        deps.log(
+          "[auto-update-checker] startup check already completed in this process; skipping per-instance rerun",
+        )
+        return
+      }
+
       hasScheduled = true
+      processState.running = true
 
       scheduleDeferredStartupCheck(() => {
         hasChecked = true
@@ -125,6 +135,15 @@ export function createAutoUpdateCheckerHook(
             deps.log("[auto-update-checker] Background update check failed:", err)
           })
         })()
+          .catch((error) => {
+            // A failed startup check must neither crash the process nor fan
+            // out retries on the next plugin instance (local fix 26).
+            deps.log("[auto-update-checker] startup check failed:", error)
+          })
+          .finally(() => {
+            processState.running = false
+            processState.completed = true
+          })
       })
     },
   }
diff --git a/packages/omo-opencode/src/hooks/auto-update-checker/startup-check-process-state.ts b/packages/omo-opencode/src/hooks/auto-update-checker/startup-check-process-state.ts
new file mode 100644
index 000000000..73799c3a3
--- /dev/null
+++ b/packages/omo-opencode/src/hooks/auto-update-checker/startup-check-process-state.ts
@@ -0,0 +1,39 @@
+/**
+ * Startup-check state kept per PROCESS, not per plugin instance (local fix 26,
+ * first-message-drop F5a).
+ *
+ * OpenCode rebuilds plugin instances on folder release/eviction, and every
+ * fresh instance used to re-run the whole deferred startup check (~0.85s each:
+ * provider-list fetch + a 3,823-model capabilities-cache rewrite + npm update
+ * check), fanning out across all live instances ~5s after any root
+ * session.created (79 cache rewrites in 26h).
+ *
+ * Stored on globalThis behind a registered symbol so it survives per-location
+ * plugin module re-imports within the same OpenCode process. This module is a
+ * deliberate dependency leaf: the test preload imports it, so it must not pull
+ * any module with import-time side effects (HOME reads, config caches, shims).
+ */
+export const STARTUP_CHECK_PROCESS_STATE_SYMBOL = Symbol.for(
+  "omo.autoUpdateChecker.startupCheckState.v1",
+)
+
+export type StartupCheckProcessState = {
+  completed: boolean
+  running: boolean
+}
+
+export function getStartupCheckProcessState(): StartupCheckProcessState {
+  const holder = globalThis as Record<symbol, StartupCheckProcessState | undefined>
+  let state = holder[STARTUP_CHECK_PROCESS_STATE_SYMBOL]
+  if (state === undefined) {
+    state = { completed: false, running: false }
+    holder[STARTUP_CHECK_PROCESS_STATE_SYMBOL] = state
+  }
+  return state
+}
+
+/** Test-only: reset the per-process startup-check gate. */
+export function resetStartupCheckProcessStateForTests(): void {
+  const holder = globalThis as Record<symbol, StartupCheckProcessState | undefined>
+  delete holder[STARTUP_CHECK_PROCESS_STATE_SYMBOL]
+}
