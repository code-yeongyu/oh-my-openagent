From 389e2a21736be3bad0f4f013d1dac766900d6ac9 Mon Sep 17 00:00:00 2001
From: "Mohamed R. Khalil" <m.radwan.khalil@gmail.com>
Date: Sat, 17 Oct 2026 01:26:58 +0300
Subject: [PATCH] fix(runtime-fallback): accept subscription quota retry
 statuses

---
 .../claude-session-limit-status.test.ts       | 71 +++++++++++++++++++
 .../session-status-handler.ts                 | 12 +++-
 2 files changed, 81 insertions(+), 2 deletions(-)
 create mode 100644 packages/omo-opencode/src/hooks/runtime-fallback/claude-session-limit-status.test.ts

diff --git a/packages/omo-opencode/src/hooks/runtime-fallback/claude-session-limit-status.test.ts b/packages/omo-opencode/src/hooks/runtime-fallback/claude-session-limit-status.test.ts
new file mode 100644
index 000000000..7f49ba826
--- /dev/null
+++ b/packages/omo-opencode/src/hooks/runtime-fallback/claude-session-limit-status.test.ts
@@ -0,0 +1,71 @@
+import { afterEach, describe, expect, test } from "bun:test"
+import { unsafeTestValue } from "../../../../../test-support/unsafe-test-value"
+import { SessionCategoryRegistry } from "../../shared/session-category-registry"
+import { releaseAllPromptAsyncReservationsForTesting } from "../shared/prompt-async-gate"
+import { toV1Event } from "../../v2/event-shape"
+import { createRuntimeFallbackHook } from "./hook"
+import type { RuntimeFallbackPluginInput } from "./types"
+
+describe("Claude subscription quota retry status", () => {
+  afterEach(() => {
+    SessionCategoryRegistry.clear()
+    releaseAllPromptAsyncReservationsForTesting()
+  })
+
+  for (const [message, expectedCount] of [
+    ["You've hit your session limit · resets 12:40am (Africa/Cairo) · limit resets in 12m (2026-10-16T21:40:00.000Z)", 1],
+    ["You've hit your weekly limit · resets Oct 20", 1],
+    ["Prompt exceeds the context window", 0],
+    ["terminal quota exhausted", 0],
+    ["Normal progress update", 0],
+  ] as const) {
+    test(`dispatches ${expectedCount} cross-provider continuations for ${message}`, async () => {
+      const sessionID = "ses_quota_status_regression"
+      const prompts: Array<{ body: { model: unknown; parts: unknown } }> = []
+      const aborts: unknown[] = []
+      const hook = createRuntimeFallbackHook(
+        unsafeTestValue<RuntimeFallbackPluginInput>({
+          directory: "/test/dir",
+          client: {
+            tui: { showToast: async () => ({}) },
+            session: {
+              abort: async (args: unknown) => { aborts.push(args); return {} },
+              messages: async () => ({ data: [{
+                info: { role: "user", agent: "Sisyphus-Junior", model: { providerID: "claude-code", modelID: "sonnet" } },
+                parts: [{ type: "text", text: "Finish the requested implementation" }],
+              }] }),
+              promptAsync: async (args: { body: { model: unknown; parts: unknown } }) => {
+                prompts.push(args)
+                return {}
+              },
+            },
+          },
+        }),
+        {
+          config: { enabled: true, retry_on_errors: [429, 500, 502, 503, 504, 529],
+            max_fallback_attempts: 5, cooldown_seconds: 600, notify_on_fallback: false,
+            restore_primary_after_cooldown: true },
+          pluginConfig: {
+            git_master: { commit_footer: true, include_co_authored_by: true, git_env_prefix: "GIT_MASTER_" },
+            agents: { "sisyphus-junior": { fallback_models: ["openai/gpt-6.1-sol"] } },
+          },
+        },
+      )
+      try {
+        await hook.event({ event: toV1Event({ type: "session.created", data: { sessionID } }) })
+        await hook.event({ event: toV1Event({ type: "session.retry.scheduled", data: {
+          sessionID, attempt: 2,
+          error: { message, detail: { error: { type: "rate_limit_error", code: "claude_session_limit" } } },
+        } }) })
+        expect(aborts).toHaveLength(expectedCount)
+        expect(prompts).toHaveLength(expectedCount)
+        if (expectedCount > 0) {
+          expect(prompts[0]?.body.model).toEqual({ providerID: "openai", modelID: "gpt-6.1-sol" })
+          expect(prompts[0]?.body.parts).toEqual([{ type: "text", text: "Finish the requested implementation" }])
+        }
+      } finally {
+        await hook.dispose?.()
+      }
+    })
+  }
+})
diff --git a/packages/omo-opencode/src/hooks/runtime-fallback/session-status-handler.ts b/packages/omo-opencode/src/hooks/runtime-fallback/session-status-handler.ts
index a0a569c1a..b874cf77b 100644
--- a/packages/omo-opencode/src/hooks/runtime-fallback/session-status-handler.ts
+++ b/packages/omo-opencode/src/hooks/runtime-fallback/session-status-handler.ts
@@ -2,7 +2,7 @@ import type { FallbackState, HookDeps } from "./types"
 import type { AutoRetryHelpers } from "./auto-retry"
 import { HOOK_NAME, RETRYABLE_ERROR_PATTERNS } from "./constants"
 import { log } from "../../shared/logger"
-import { extractAutoRetrySignal } from "./error-classifier"
+import { classifyErrorType, extractAutoRetrySignal } from "./error-classifier"
 import { canPrepareFallback, createFallbackState } from "./fallback-state"
 import { getFallbackModelsForSession } from "./fallback-models"
 import { normalizeRetryStatusMessage, extractRetryAttempt } from "../../shared/retry-status-utils"
@@ -56,7 +56,15 @@ export function createSessionStatusHandler(
       // retryable error patterns directly. This handles providers like Gemini whose
       // retry status message may not contain "retrying in" text alongside the error.
       const messageLower = retryMessage.toLowerCase()
-      const matchesRetryablePattern = RETRYABLE_ERROR_PATTERNS.some((pattern) => pattern.test(messageLower))
+      // Claude subscription 429s say "session limit" / "weekly limit", not
+      // "retrying in". Reuse the quota classifier used by session.error so
+      // native retries cannot bypass an otherwise eligible fallback chain.
+      const matchesQuotaRetryStatus = classifyErrorType(retryMessage) === "quota_exceeded"
+      const matchesRetryablePattern = matchesQuotaRetryStatus
+        || RETRYABLE_ERROR_PATTERNS.some((pattern) => pattern.test(messageLower))
+      if (matchesQuotaRetryStatus) {
+        log(`[${HOOK_NAME}] quota retry status accepted for fallback`, { sessionID })
+      }
       if (!matchesRetryablePattern) {
         // Diagnostic: capture the actual retry message content so we can extend
         // RETRYABLE_ERROR_PATTERNS if a provider emits a phrasing we don't yet match.
-- 
