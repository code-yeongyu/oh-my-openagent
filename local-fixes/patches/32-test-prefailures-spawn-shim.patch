diff --git a/packages/omo-opencode/src/v2/session-db.test.ts b/packages/omo-opencode/src/v2/session-db.test.ts
index 03176704d..e386c79b0 100644
--- a/packages/omo-opencode/src/v2/session-db.test.ts
