diff --git a/packages/omo-opencode/src/shared/native-plugin-context.test.ts b/packages/omo-opencode/src/shared/native-plugin-context.test.ts
new file mode 100644
index 000000000..cf6b19ac4
--- /dev/null
+++ b/packages/omo-opencode/src/shared/native-plugin-context.test.ts
@@ -0,0 +1,25 @@
+import { describe, expect, test } from "bun:test"
+import { hasActiveNativeContextMode, withNativePluginLookup } from "./native-plugin-context"
+
+describe("native plugin capability bridge", () => {
+  test("unsupported host keeps the Claude bridge", async () => {
+    expect(await hasActiveNativeContextMode({})).toBe(false)
+  })
+
+  test("reads activation state afresh and scopes it to this host context", async () => {
+    let status = "loading"
+    const input = withNativePluginLookup({}, async () => ({ data: [{ id: "context-mode", state: { status } }] }))
+    expect(await hasActiveNativeContextMode(input)).toBe(false)
+    status = "active"
+    expect(await hasActiveNativeContextMode(input)).toBe(true)
+    expect(await hasActiveNativeContextMode({})).toBe(false)
+    status = "error"
+    expect(await hasActiveNativeContextMode(input)).toBe(false)
+  })
+
+  test("does not mistake configuration or a similar plugin id for active native ownership", async () => {
+    for (const result of [{ data: [{ id: "context-mode" }] }, { data: [{ id: "not-context-mode", state: { status: "active" } }] }, null, {}]) {
+      expect(await hasActiveNativeContextMode(withNativePluginLookup({}, async () => result))).toBe(false)
+    }
+  })
+})
diff --git a/packages/omo-opencode/src/shared/native-plugin-context.ts b/packages/omo-opencode/src/shared/native-plugin-context.ts
new file mode 100644
index 000000000..bbc92843d
--- /dev/null
+++ b/packages/omo-opencode/src/shared/native-plugin-context.ts
@@ -0,0 +1,25 @@
+import { log } from "./logger"
+
+// OMO-internal capability bridge, not a speculative property on the host API.
+const nativePluginLookups = new WeakMap<object, () => Promise<unknown>>()
+
+export function withNativePluginLookup<T extends object>(input: T, lookup?: () => Promise<unknown>): T {
+  if (lookup) nativePluginLookups.set(input, lookup)
+  return input
+}
+
+export async function hasActiveNativeContextMode(input: object): Promise<boolean> {
+  const lookup = nativePluginLookups.get(input)
+  if (!lookup) return false
+  try {
+    const result = await lookup() as { data?: Array<{ id?: string; state?: { status?: string } }> }
+    return Array.isArray(result?.data) && result.data.some(
+      (plugin) => plugin.id === "context-mode" && plugin.state?.status === "active",
+    )
+  } catch (error) {
+    log("[claude-code-hooks] native plugin lookup failed; preserving prompt bridge", {
+      error: error instanceof Error ? error.message : String(error),
+    })
+    return false
+  }
+}
