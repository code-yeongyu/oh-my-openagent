+/// <reference types="bun-types" />
+import { expect, test } from "bun:test"
+import { createOmoDelegationRouting, OMO_DELEGATION_RULE, type OmoRoutingEvent } from "./delegation-routing"
+
+const route = createOmoDelegationRouting(["Localized OMO Display Name"])
+
+for (const agent of ["oracle", "oh-my-openagent/oracle", "Sisyphus - ultraworker", "Sisyphus-Junior", "Localized OMO Display Name"]) {
+  test(`filters only native subagent for owned OMO identity ${agent}`, () => {
+    const event: OmoRoutingEvent = { agent, system: [], tools: { subagent: {}, execute: {}, task: {}, other: {} } }
+    route(event, { hideNativeTool: true })
+    expect(Object.hasOwn(event.tools!, "subagent")).toBe(false)
+    expect(Object.keys(event.tools!).sort()).toEqual(["execute", "other", "task"])
+    expect(event.system).toEqual([{ type: "text", text: OMO_DELEGATION_RULE }])
+    route(event, { hideNativeTool: true })
+    expect(event.system).toHaveLength(1)
+  })
+}
+
+for (const agent of ["general", "build", "plan", "custom", "oh-my-openagent/custom", "oracle-custom", "compaction", "ocBuilder", undefined]) {
+  test(`leaves non-OMO identity ${agent} untouched`, () => {
+    const event: OmoRoutingEvent = { agent, system: [{ type: "text", text: "original" }], tools: { subagent: {}, execute: {} } }
+    const before = structuredClone(event)
+    route(event, { hideNativeTool: true })
+    expect(event).toEqual(before)
+  })
+}
+
+test("prompt-only mode retains native tool; filter is explicitly opted in", () => {
+  const event: OmoRoutingEvent = { agent: "oracle", system: [], tools: { subagent: {} } }
+  route(event)
+  expect(Object.hasOwn(event.tools!, "subagent")).toBe(true)
+  expect(event.system).toEqual([{ type: "text", text: OMO_DELEGATION_RULE }])
+})
+
+test("agent switch removes only our stale prompt from native context", () => {
+  const original = { type: "text" as const, text: "original" }
+  const event: OmoRoutingEvent = { agent: "general", system: [original, { type: "text", text: OMO_DELEGATION_RULE }], tools: { subagent: {} } }
+  route(event, { hideNativeTool: true })
+  expect(event.system).toEqual([original])
+  expect(Object.hasOwn(event.tools!, "subagent")).toBe(true)
+})
+
+test("native primary identities cannot be claimed through additional OMO aliases", () => {
+  const attempt = createOmoDelegationRouting(["general", "build", "plan"])
+  for (const agent of ["general", "build", "plan"]) {
+    const event: OmoRoutingEvent = { agent, system: [], tools: { subagent: {} } }
+    attempt(event, { hideNativeTool: true })
+    expect(event.system).toEqual([])
+    expect(Object.hasOwn(event.tools!, "subagent")).toBe(true)
+  }
+})
diff --git a/packages/omo-opencode/src/v2/delegation-routing.ts b/packages/omo-opencode/src/v2/delegation-routing.ts
new file mode 100644
index 000000000..140126dc7
--- /dev/null
+++ b/packages/omo-opencode/src/v2/delegation-routing.ts
@@ -0,0 +1,39 @@
+import { AGENT_DISPLAY_NAMES, getAgentConfigKey } from "../shared/agent-display-names"
+
+export const OMO_DELEGATION_RULE = [
+  "OMO delegation routing: delegate ONLY through tools.task in the current Code Mode catalog.",
+  "Discover tools.task with search before calling it; use its actual category and load_skills schema.",
+  "Do not use native subagent or another delegation entry point for OMO agents.",
+  "If tools.task is unavailable, stop and report the missing route; never silently fall back.",
+  "This rule applies only to OMO agents. Native general, build, plan, and custom agents retain native subagent behavior.",
+].join("\n")
+
+export type OmoRoutingEvent = {
+  agent?: string
+  system: Array<{ type: "text"; text: string }>
+  tools?: Record<string, unknown>
+}
+
+export function createOmoDelegationRouting(additionalOwnedIDs: readonly string[] = []) {
+  // Only explicit OMO definitions establish ownership. Generated Markdown and
+  // config.agent also contain native/custom agents, so neither is a scope test.
+  const additional = new Set(additionalOwnedIDs.map((id) => id.toLowerCase()))
+  return (event: OmoRoutingEvent, options: { hideNativeTool?: boolean } = {}): void => {
+    for (let index = event.system.length - 1; index >= 0; index--) {
+      if (event.system[index].type === "text" && event.system[index].text === OMO_DELEGATION_RULE) {
+        event.system.splice(index, 1)
+      }
+    }
+    if (typeof event.agent !== "string") return
+    const id = event.agent.startsWith("oh-my-openagent/")
+      ? event.agent.slice("oh-my-openagent/".length)
+      : event.agent
+    if (["general", "build", "plan"].includes(id.toLowerCase())) return
+    if (!Object.hasOwn(AGENT_DISPLAY_NAMES, getAgentConfigKey(id)) && !additional.has(id.toLowerCase())) return
+    event.system.push({ type: "text", text: OMO_DELEGATION_RULE })
+    // Opt-in only: callers must prove event.tools is fresh per inference.
+    // Never remove from the global registry. Native permissions enforce the
+    // configured deny even when this optional presentation filter is disabled.
+    if (options.hideNativeTool === true && event.tools) delete event.tools.subagent
+  }
+}
