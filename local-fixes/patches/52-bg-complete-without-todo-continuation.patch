+        } as Parameters<typeof pluginModule.server>[0])
+
+        // then
+        expect(mockCreateManagers.mock.calls.at(0)?.[0]).toMatchObject({
+          todoContinuationEnforcerEnabled: false,
+        })
+      } finally {
+        mockLoadPluginConfig.mockReturnValue({})
+      }
+    })
+  })
 })
