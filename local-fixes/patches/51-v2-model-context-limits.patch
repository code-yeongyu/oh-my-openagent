From 87c06893e8370934f4ba73e48081372b4d14a861 Mon Sep 17 00:00:00 2001
From: "Mohamed R. Khalil" <m.radwan.khalil@gmail.com>
Date: Mon, 19 Oct 2026 15:50:20 +0300
Subject: [PATCH] fix(v2): seed the context-limit cache from the host model
 catalog

On V1, OpenCode hands the config hook the user's provider map and
applyProviderConfig fills modelContextLimitsCache from each model's
limit.context. On V2 the adapter calls the config hook with an empty scratch
object, so applyProviderConfig clears the cache and never fills it.
resolveActualContextLimit then returns null for every non-Anthropic provider
and preemptive compaction never fires: 359 of 359 [preemptive-compaction]
lines in %TEMP%/oh-my-opencode.log were "Skipping preemptive compaction:
unknown context limit for model" (opencode-go/deepseek-v4.1-flash at 79.1%,
openai/gpt-6-astra, claude-code/claude-opus-5-5).

setupOpenCodeV2 now reads ctx.model.list() (bounded at 2 s, failures logged
and ignored) and seeds scratch.provider with {models: {id: {limit: {context}}}}
for every model whose catalog entry carries a limit, keyed by the catalog id
and, when different, the API modelID. After the config hook runs, provider
entries that are still pure seed are removed again so projectProviders does
not register host providers as plugin-declared ones; providers the plugin
itself configured keep their entries.
---
 packages/omo-opencode/src/v2/host.test.ts | 104 ++++++++++++++++++++++
 packages/omo-opencode/src/v2/host.ts      |  75 ++++++++++++++++
 2 files changed, 179 insertions(+)

diff --git a/packages/omo-opencode/src/v2/host.test.ts b/packages/omo-opencode/src/v2/host.test.ts
index 233c78994..957bb2264 100644
--- a/packages/omo-opencode/src/v2/host.test.ts
+++ b/packages/omo-opencode/src/v2/host.test.ts
@@ -6,6 +6,9 @@ import type { Plugin } from "@opencode/plugin"
 import { afterEach, describe, expect, test } from "bun:test"
 import { z } from "zod"
 
+import { applyProviderConfig } from "../plugin-handlers/provider-config-handler"
+import { createModelCacheState } from "../plugin-state"
+import { resolveActualContextLimit } from "../shared/context-limit-resolver"
 import { createAdapterState } from "./adapter-state"
 import { permissionsFromV1, renderAgentMarkdown } from "./agent-markdown"
 import { createV1PluginInput } from "./context-facade"
@@ -805,3 +808,104 @@ describe("fix 50 session ownership (opencode-v2)", () => {
     await cleanup?.()
   })
 })
+
+describe("fix 51 model context limits (opencode-v2)", () => {
+  const directories: string[] = []
+
+  afterEach(() => {
+    for (const directory of directories.splice(0)) rmSync(directory, { recursive: true, force: true })
+  })
+
+  function setup(opts: {
+    models: () => Promise<unknown>
+    config?: (config: Record<string, unknown>) => void
+  }): { fake: ReturnType<typeof createFakeContext>; modelCacheState: ReturnType<typeof createModelCacheState>; added: string[]; run: () => Promise<unknown> } {
+    const fake = createFakeContext()
+    const directory = mkdtempSync(join(tmpdir(), "omo-v2-limits-"))
+    directories.push(directory)
+    const modelCacheState = createModelCacheState()
+    const added: string[] = []
+    const host = fake.ctx as unknown as {
+      model: { list: () => Promise<unknown> }
+      provider: { transform: (fn: (editor: Record<string, unknown>) => void) => Promise<void> }
+    }
+    host.model.list = opts.models
+    host.provider.transform = async (fn) => {
+      fn({
+        list: () => [],
+        get: () => undefined,
+        add(provider: { info: { id: unknown } }) {
+          added.push(String(provider.info.id))
+        },
+        update() {},
+        remove() {},
+        models: { set() {}, update() {}, remove() {} },
+      })
+    }
+    const run = () => setupOpenCodeV2(fake.ctx, {
+      agentDirectory: directory,
+      server: async () => ({
+        // Mirrors the V1 config handler's provider phase.
+        config: async (config: Record<string, unknown>) => {
+          opts.config?.(config)
+          applyProviderConfig({ config, modelCacheState })
+        },
+      }),
+    })
+    return { fake, modelCacheState, added, run }
+  }
+
+  test("seeds the context-limit cache from the host model catalog", async () => {
+    const { modelCacheState, added, run } = setup({
+      models: async () => [
+        { id: "deepseek-v4.1-flash", modelID: "deepseek-v4.1-flash", providerID: "opencode-go", limit: { context: 1_000_000, output: 384_000 } },
+        { id: "gpt-6-astra", modelID: "gpt-6-astra", providerID: "openai", limit: { context: 1_050_000, output: 128_000 } },
+        { id: "claude-opus-5-5", modelID: "claude-opus-5-5", providerID: "claude-code", limit: { context: 1_000_000, output: 64_000 } },
+        { id: "alias", modelID: "api-name", providerID: "openai", limit: { context: 400_000, output: 32_000 } },
+      ],
+    })
+
+    await run()
+
+    expect(resolveActualContextLimit("opencode-go", "deepseek-v4.1-flash", modelCacheState)).toBe(1_000_000)
+    expect(resolveActualContextLimit("openai", "gpt-6-astra", modelCacheState)).toBe(1_050_000)
+    expect(resolveActualContextLimit("claude-code", "claude-opus-5-5", modelCacheState)).toBe(1_000_000)
+    expect(resolveActualContextLimit("openai", "alias", modelCacheState)).toBe(400_000)
+    expect(resolveActualContextLimit("openai", "api-name", modelCacheState)).toBe(400_000)
+    // The seed is host data: it must not be projected back as plugin-declared providers.
+    expect(added).toEqual([])
+  })
+
+  test("keeps providers the plugin itself declares", async () => {
+    const { modelCacheState, added, run } = setup({
+      models: async () => ({ data: [{ id: "m", providerID: "p", limit: { context: 300_000, output: 1 } }] }),
+      config: (config) => {
+        const providers = config.provider as Record<string, unknown>
+        providers.own = { name: "Own", models: { x: { limit: { context: 128_000 } } } }
+      },
+    })
+
+    await run()
+
+    expect(resolveActualContextLimit("p", "m", modelCacheState)).toBe(300_000)
+    expect(resolveActualContextLimit("own", "x", modelCacheState)).toBe(128_000)
+    expect(added).toEqual(["own"])
+  })
+
+  test("setup still completes when the model catalog is unavailable", async () => {
+    let configured = false
+    const { modelCacheState, run } = setup({
+      models: async () => {
+        throw new Error("catalog down")
+      },
+      config: () => {
+        configured = true
+      },
+    })
+
+    await run()
+
+    expect(configured).toBe(true)
+    expect(resolveActualContextLimit("opencode-go", "deepseek-v4.1-flash", modelCacheState)).toBeNull()
+  })
+})
diff --git a/packages/omo-opencode/src/v2/host.ts b/packages/omo-opencode/src/v2/host.ts
index 5cb59d6f9..aa8d30f4f 100644
--- a/packages/omo-opencode/src/v2/host.ts
+++ b/packages/omo-opencode/src/v2/host.ts
@@ -9,6 +9,8 @@ import { projectV1Surface } from "./project-config"
 
 type V1Server = (input: never, options: unknown) => Promise<V1HookMap>
 
+const MODEL_LIST_TIMEOUT_MS = 2_000
+
 // Local fix 47: hand the shared backend event loop back between setup stages of a new folder.
 function yieldToEventLoop(): Promise<void> {
   return new Promise((resolve) => setImmediate(resolve))
@@ -18,6 +20,77 @@ function isRecord(value: unknown): value is Record<string, unknown> {
   return typeof value === "object" && value !== null
 }
 
+function rowsOf(value: unknown): Record<string, unknown>[] {
+  if (Array.isArray(value)) return value.filter(isRecord)
+  if (isRecord(value) && Array.isArray(value.data)) return value.data.filter(isRecord)
+  return []
+}
+
+type SeededProviders = Map<string, { provider: Record<string, unknown>; models: Map<string, Record<string, unknown>> }>
+
+/**
+ * Local fix 51: on V1, OpenCode hands the config hook the user's provider map, and
+ * applyProviderConfig fills the context-limit cache from each model's `limit.context`.
+ * V2 owns provider config itself, so the hook receives an empty object, the cache stays
+ * empty, and preemptive compaction skips every non-Anthropic model with "unknown context
+ * limit". Seed the provider map with the limits the host's model catalog already carries.
+ */
+async function seedModelContextLimits(ctx: Plugin.Context, config: Record<string, unknown>): Promise<SeededProviders> {
+  const seeded: SeededProviders = new Map()
+  let listed: unknown
+  try {
+    let timer: ReturnType<typeof setTimeout> | undefined
+    const timeout = new Promise<undefined>((resolve) => {
+      timer = setTimeout(() => resolve(undefined), MODEL_LIST_TIMEOUT_MS)
+    })
+    listed = await Promise.race([ctx.model.list(), timeout]).finally(() => clearTimeout(timer))
+  } catch (error) {
+    log("[oh-my-openagent] model context limits unavailable", {
+      error: error instanceof Error ? error.message : String(error),
+    })
+    return seeded
+  }
+
+  const providers: Record<string, unknown> = {}
+  for (const model of rowsOf(listed)) {
+    const providerID = typeof model.providerID === "string" ? model.providerID : undefined
+    const context = isRecord(model.limit) && typeof model.limit.context === "number" ? model.limit.context : undefined
+    if (!providerID || !context || context <= 0) continue
+    // Sessions name a model by its catalog id; modelID is the API id when the two differ.
+    const ids = [model.id, model.modelID].filter((id): id is string => typeof id === "string" && id.length > 0)
+    for (const modelID of ids) {
+      let entry = seeded.get(providerID)
+      if (!entry) {
+        entry = { provider: { models: {} }, models: new Map() }
+        seeded.set(providerID, entry)
+        providers[providerID] = entry.provider
+      }
+      if (entry.models.has(modelID)) continue
+      const modelConfig = { limit: { context } }
+      entry.models.set(modelID, modelConfig)
+      ;(entry.provider.models as Record<string, unknown>)[modelID] = modelConfig
+    }
+  }
+  if (seeded.size > 0) config.provider = providers
+  log("[oh-my-openagent] v2 model context limits seeded", { models: [...seeded.values()].reduce((sum, entry) => sum + entry.models.size, 0) })
+  return seeded
+}
+
+/** Drops the seed again so it is not projected back onto the host as V1-declared providers. */
+function unseedModelContextLimits(config: Record<string, unknown>, seeded: SeededProviders): void {
+  if (seeded.size === 0 || !isRecord(config.provider)) return
+  const providers = config.provider
+  for (const [providerID, entry] of seeded) {
+    if (providers[providerID] !== entry.provider) continue
+    // A provider the plugin itself configured keeps its entry; the seeded models only carry limits.
+    if (Object.keys(entry.provider).some((key) => key !== "models")) continue
+    const models = isRecord(entry.provider.models) ? entry.provider.models : {}
+    const untouched = Object.entries(models).every(([modelID, modelConfig]) => entry.models.get(modelID) === modelConfig)
+    if (untouched) delete providers[providerID]
+  }
+  if (Object.keys(providers).length === 0) delete config.provider
+}
+
 export async function setupOpenCodeV2(
   ctx: Plugin.Context,
   deps: {
@@ -48,6 +121,7 @@ export async function setupOpenCodeV2(
   await yieldToEventLoop()
   const scratch: Record<string, unknown> = {}
   if (typeof hooks.config === "function") {
+    const seeded = await seedModelContextLimits(ctx, scratch)
     try {
       await hooks.config(scratch)
     } catch (error) {
@@ -55,6 +129,7 @@ export async function setupOpenCodeV2(
         error: error instanceof Error ? error.message : String(error),
       })
     }
+    unseedModelContextLimits(scratch, seeded)
   }
 
   await yieldToEventLoop()
