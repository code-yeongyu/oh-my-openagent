# programming's go scaffolder copies these templates byte for byte into a project whose .editorconfig says end_of_line = lf.
packages/shared-skills/skills/programming/scripts/go/templates/* text eol=lf
# script/build-brand-logo.ts embeds .github/assets/omo-icon-light.svg in SENPI_BRAND; a CRLF checkout must not change it.
*.svg text eol=lf

# The vendored sync-format copy and its fixtures are checked byte for byte against a hash manifest
# (memory-core sync/crypto/vendor-integrity.test.ts): no line-ending conversion on any platform.
packages/memory-core/src/sync/crypto/vendor/** -text

# Generated OpenTelemetry protobuf code, vendored byte-identical from the collector and pinned by its SHA256SUMS:
# no line-ending conversion and no whitespace checks (the upstream generator leaves trailing blanks).
packages/telemetry-core/src/otlp-proto/** -text -whitespace

# The engine's vendored copy of the telemetry collector's registry is pinned byte for byte by hash (schema-registry/PINS.json,
# telemetry-artifact.test.ts): no line-ending conversion on any platform.
packages/omo-senpi/src/components/telemetry/schema-registry/** -text
